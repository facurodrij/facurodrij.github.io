---
import Container from '../components/Container.astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Technologies from '../components/Technologies.astro';
import TitleSection from '../components/TitleSection.astro';
import Projects from '../components/Projects.astro';
import AboutMe from '../components/AboutMe.astro';
import Experience from '../components/Experience.astro';
---

<Layout title="Portfolio de facurodrij - Desarrollador web">
	<main class="pb-8 pt-4">
		<Container id="Banner" class="py-28 md:py-36">
			<Hero />
		</Container>
		<div class="space-y-24 pb-8 md:space-y-28">
			<Container id="tecnologias">
				<TitleSection>Tecnologías</TitleSection>
				<Technologies />
			</Container>
			<Container id="experiencia">
				<TitleSection>Experiencia laboral</TitleSection>
				<p class="ds-body mx-auto mb-8 max-w-2xl text-center">
					Recorrido profesional construyendo soluciones web, productos y
					arquitecturas orientadas a impacto real.
				</p>
				<Experience />
			</Container>
			<Container id="proyectos">
				<TitleSection>Proyectos</TitleSection>
				<p class="ds-body mx-auto mb-8 max-w-2xl text-center">
					Selección de proyectos donde apliqué desarrollo full stack,
					integración de herramientas y criterio técnico.
				</p>
				<Projects />
			</Container>
			<Container id="sobre-mi">
				<TitleSection>Sobre mí</TitleSection>
				<p class="ds-body mx-auto mb-8 max-w-2xl text-center">
					Perfil, enfoque de trabajo e intereses que hoy orientan mi camino en
					desarrollo, cloud y arquitectura.
				</p>
				<AboutMe />
			</Container>
		</div>
	</main>
</Layout>
