---
import Container from '../components/Container.astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Technologies from '../components/Technologies.astro';
import TitleSection from '../components/TitleSection.astro';
import Projects from '../components/Projects.astro';
import AboutTerminal from '../components/AboutTerminal.astro';
import Experience from '../components/Experience.astro';
---

<Layout title="Facundo Rodriguez — Full Stack Developer">
	<main class="pb-8 pt-4">
		<Container id="Banner" class="pt-20 pb-36 md:pt-28 md:pb-48">
			<Hero />
		</Container>
		<div class="space-y-24 pb-8 md:space-y-28">
			<Container id="sobre-mi">
				<TitleSection
					><span class="ds-section-title-shimmer">Quién soy</span></TitleSection
				>
				<p class="ds-body mx-auto mb-8 max-w-2xl text-center">
					Explorá los archivos o escribí
					<code
						class="rounded-md border border-[var(--color-border)] px-1.5 py-0.5 font-[var(--font-mono)] text-[0.9em] text-[var(--color-heading)]"
						>help</code
					>
					en la terminal.
				</p>
				<AboutTerminal />
			</Container>
			<Container id="experiencia">
				<TitleSection
					><span class="text-[var(--color-heading)]">Mi</span>
					<span class="ds-section-title-shimmer">Recorrido</span></TitleSection
				>
				<p class="ds-body mx-auto mb-8 max-w-2xl text-center">
					Recorrido profesional construyendo soluciones web, productos y
					arquitecturas orientadas a impacto real.
				</p>
				<Experience />
			</Container>
			<Container id="tecnologias">
				<TitleSection
					><span class="text-[var(--color-heading)]">Mi</span>
					<span class="ds-section-title-shimmer">TechStack</span></TitleSection
				>
				<Technologies />
			</Container>
			<Container id="proyectos">
				<TitleSection
					><span class="text-[var(--color-heading)]">Mis</span>
					<span class="ds-section-title-shimmer">Proyectos</span></TitleSection
				>
				<p class="ds-body mx-auto mb-8 max-w-2xl text-center">
					Algunos de mis trabajos más destacados.
				</p>
				<Projects />
			</Container>
		</div>
	</main>
</Layout>
