---
import DownloadIcon from './icons/Download.astro';
import LinkedInIcon from './icons/LinkedIn.astro';
import TelegramIcon from './icons/Telegram.astro';
import GithubIcon from './icons/Github.astro';
import SocialPill from './SocialPill.astro';
---

<div class="ds-card-strong overflow-hidden px-6 py-8 sm:px-8 sm:py-10">
	<div
		class="grid grid-cols-1 gap-8 md:grid-cols-[minmax(0,1.45fr)_minmax(220px,0.7fr)] md:items-center"
	>
		<div>
			<span class="ds-eyebrow mb-5">
				<span class="h-2 w-2 rounded-full bg-[var(--color-primary)]"></span>
				Disponible para nuevos desafíos
			</span>
			<h1
				data-ui-heading="true"
				class="max-w-3xl text-4xl font-bold sm:text-5xl lg:text-6xl"
			>
				Hola! Soy Facundo Joel Rodriguez
			</h1>
			<p
				class="ds-body mt-6 max-w-2xl text-lg sm:text-xl [&>strong]:font-semibold [&>strong]:text-[var(--color-heading)]"
			>
				Licenciado en Sistemas de Información.
				<strong>Desarrollador FullStack de Aplicaciones Web</strong>
				de Misiones, Argentina.
			</p>
		</div>
		<div class="flex items-center justify-center md:justify-end">
			<a
				href="https://www.linkedin.com/in/facundo-joel-rodriguez/"
				target="_blank"
				rel="noopener"
				class="group relative block"
			>
				<div
					class="absolute inset-0 rounded-[1.75rem] bg-[radial-gradient(circle_at_top,rgba(56,189,248,0.28),transparent_60%)] blur-2xl"
				>
				</div>
				<img
					class="ds-card relative size-64 rounded-[1.75rem] object-cover shadow-2xl md:size-56 md:group-hover:-translate-y-1"
					src="/me.webp"
					alt="Foto de Facundo Joel Rodriguez"
				/>
			</a>
		</div>
	</div>
	<nav class="mt-8 flex flex-wrap gap-3">
		<a
			href="/curriculum_vitae.pdf"
			target="_blank"
			rel="noopener noreferrer"
			role="link"
			class={`ds-button ds-button-primary ${Astro.props.class}`}
		>
			<DownloadIcon class="size-4" />
			Resume / CV
		</a>
		<SocialPill href="https://www.linkedin.com/in/facundo-joel-rodriguez/">
			<LinkedInIcon class="size-4" />
			LinkedIn
		</SocialPill>
		<SocialPill href="https://github.com/facurodrij">
			<GithubIcon class="size-4" />
			Github
		</SocialPill>
		<SocialPill href="https://t.me/facurodrij">
			<TelegramIcon class="size-4" />
			Telegram
		</SocialPill>
	</nav>
</div>
