---
import ImageCarousel from '../ImageCarousel.astro';
import ventasImage from '../../assets/projects/1.webp';
import articuloFormularioImage from '../../assets/projects/stockcar/articulo-formulario.png';
import articulosImage from '../../assets/projects/stockcar/articulos.png';

const slides = [
	{
		src: ventasImage,
		alt: 'Listado de ventas, detalle de un comprobante y facturas en PDF con el código QR de AFIP',
		caption: 'Ventas, detalle de comprobante y facturas A4 con el QR de AFIP.',
	},
	{
		src: articuloFormularioImage,
		alt: 'Formulario de alta de artículo con pestañas de códigos, facturación y observaciones',
		caption:
			'Alta de artículos con múltiples códigos, datos de facturación e inventario.',
	},
	{
		src: articulosImage,
		alt: 'Listado de artículos con búsqueda y columnas configurables',
		caption: 'Catálogo con búsqueda y columnas configurables por usuario.',
	},
];

const facts = [
	{ label: 'Rol', value: 'Único desarrollador · Freelance' },
	{ label: 'Período', value: 'Julio 2024 - Presente' },
	{ label: 'Estado', value: 'En producción' },
	{ label: 'Cliente', value: 'Repuestos Stock Car · Posadas, Misiones' },
];

const stack = [
	'Python',
	'Django',
	'Django REST Framework',
	'Next.js',
	'TypeScript',
	'MUI',
	'PostgreSQL',
	'Docker',
	'Railway',
];

const stats = [
	{ value: '869', label: 'tests de backend' },
	{ value: '79', label: 'tests end-to-end' },
	{ value: '71', label: 'endpoints REST documentados' },
	{ value: '24', label: 'decisiones de arquitectura (ADR)' },
];

const features = [
	{
		title: 'Facturación electrónica',
		detail:
			'Facturas y notas de crédito A y B autorizadas en AFIP/ARCA, con validación de la condición fiscal del receptor antes de emitir.',
	},
	{
		title: 'Ventas',
		detail:
			'Órdenes cargadas por vendedores y confirmadas por un supervisor, presupuestos, remitos y anulación con nota de crédito.',
	},
	{
		title: 'Stock',
		detail:
			'Cada ingreso, venta o ajuste queda registrado como movimiento, con historial por artículo y stock mínimo y máximo.',
	},
	{
		title: 'Compras',
		detail:
			'Recepción de mercadería que actualiza el stock, y carga asistida por IA: el JSON de la factura del proveedor se valida y se vincula con cada artículo por código.',
	},
	{
		title: 'Clientes y proveedores',
		detail:
			'Alta con consulta al padrón de AFIP para completar los datos fiscales, y baja lógica para no perder historial.',
	},
	{
		title: 'Comprobantes y reportes',
		detail:
			'PDFs en A4 y ticket con el QR fiscal, y reportes de ventas por vendedor y de artículos más vendidos.',
	},
];

const decisions = [
	{
		title: 'Stock como libro de movimientos',
		detail:
			'El stock no se pisa: cada cambio es un movimiento inmutable, con reversas, bloqueo de filas y claves de idempotencia. Así el saldo de cada artículo siempre se puede explicar y dos ventas simultáneas no lo corrompen.',
	},
	{
		title: 'Cliente propio para AFIP',
		detail:
			'Un cliente SOAP sobre zeep para WSAA, WSFEv1 y el padrón. Cada solicitud se guarda antes de enviarse y se reconcilia después, de modo que un corte de red no deja una factura autorizada sin registrar. El certificado se guarda cifrado.',
	},
	{
		title: 'Sesiones en lugar de JWT',
		detail:
			'Frontend y API comparten un único origen HTTPS detrás de Caddy, así que la autenticación usa sesiones de Django con cookies HttpOnly y CSRF. Sin tokens en el navegador y sin CORS.',
	},
	{
		title: 'El contrato OpenAPI manda',
		detail:
			'Los tipos de TypeScript del frontend se generan desde el esquema OpenAPI de la API. Si backend y frontend se desincronizan, el CI falla antes de llegar a producción.',
	},
];

const quality = [
	'Backend: ruff, chequeo de migraciones pendientes y pytest contra PostgreSQL real, con un mínimo de 80 % de cobertura.',
	'Frontend: ESLint, chequeo de tipos, verificación de que los tipos de la API están al día y build de Next.js.',
	'Tests end-to-end con Playwright, incluidas pruebas de regresión visual.',
	'Imágenes Docker multi-stage; cada despliegue en Railway corre los chequeos de Django y las migraciones antes de publicar.',
];
---

<div class="cs">
	<p class="ds-body cs-lede">
		Sistema de facturación electrónica y gestión de stock para una casa de
		repuestos automotores. Lo usa a diario el equipo de mostrador, depósito y
		administración para vender, facturar ante AFIP y controlar la mercadería.
	</p>

	<dl class="cs-facts mt-6">
		{
			facts.map((fact) => (
				<div>
					<dt>{fact.label}</dt>
					<dd>{fact.value}</dd>
				</div>
			))
		}
	</dl>

	<ul class="cs-stack mt-6" aria-label="Tecnologías">
		{stack.map((item) => <li>{item}</li>)}
	</ul>

	<div class="mt-10">
		<ImageCarousel slides={slides} label="Capturas de StockCar Gestión" />
	</div>

	<ul class="cs-stats mt-12">
		{
			stats.map((stat) => (
				<li class="ds-glass-panel">
					<span class="cs-stats__value">{stat.value}</span>
					<span class="cs-stats__label">{stat.label}</span>
				</li>
			))
		}
	</ul>

	<section class="cs-section" aria-labelledby="cs-problema">
		<h3 id="cs-problema" data-ui-heading="true">El desafío</h3>
		<div class="ds-body cs-prose">
			<p>
				Un comercio de repuestos vende en mostrador durante todo el día, con
				varios vendedores a la vez, un catálogo grande en el que cada artículo
				tiene varios códigos, y la obligación de emitir factura electrónica en
				cada venta.
			</p>
			<p>
				Eso exige tres cosas que no se pueden negociar: que la numeración fiscal
				nunca se saltee ni se duplique, que el stock no se corrompa cuando dos
				personas venden el mismo artículo al mismo tiempo, y que cada usuario
				vea y haga solo lo que le corresponde según su rol.
			</p>
		</div>
	</section>

	<section class="cs-section" aria-labelledby="cs-solucion">
		<h3 id="cs-solucion" data-ui-heading="true">Qué construí</h3>
		<ul class="cs-grid">
			{
				features.map((feature) => (
					<li class="ds-glass-panel cs-card">
						<h4>{feature.title}</h4>
						<p>{feature.detail}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section class="cs-section" aria-labelledby="cs-arquitectura">
		<h3 id="cs-arquitectura" data-ui-heading="true">Arquitectura</h3>
		<div class="ds-body cs-prose">
			<p>
				Un monolito modular en Django (10 apps de dominio, con la lógica de
				negocio en servicios y no en las vistas) expone una API REST versionada.
				Next.js renderiza las pantallas en el servidor y le habla a la API
				directamente; Caddy es el único servicio público y reparte el tráfico
				entre ambos.
			</p>
		</div>

		<figure class="cs-diagram ds-glass-panel">
			<div class="cs-diagram__scroll">
				<svg
					viewBox="0 0 760 420"
					role="img"
					aria-labelledby="cs-diagram-title cs-diagram-desc"
				>
					<title id="cs-diagram-title">Arquitectura de StockCar Gestión</title>
					<desc id="cs-diagram-desc">
						El navegador se conecta por HTTPS a Caddy, que dentro de Railway
						envía las páginas a Next.js y las llamadas a /api a Django. Next.js
						también consulta a Django desde el servidor. Django guarda los datos
						en PostgreSQL y se comunica por SOAP con los servicios web de
						AFIP/ARCA.
					</desc>
					<defs>
						<marker
							id="cs-arrow"
							viewBox="0 0 10 10"
							refX="9"
							refY="5"
							markerWidth="7"
							markerHeight="7"
							orient="auto-start-reverse"
						>
							<path d="M0 0L10 5L0 10z" class="cs-d-arrowhead"></path>
						</marker>
					</defs>

					<rect
						x="176"
						y="16"
						width="372"
						height="388"
						rx="18"
						class="cs-d-zone"></rect>
					<text x="196" y="44" class="cs-d-zone-label">Railway</text>

					<g class="cs-d-edges">
						<path d="M146 162H198" marker-end="url(#cs-arrow)"></path>
						<path d="M320 150H346V80H370" marker-end="url(#cs-arrow)"></path>
						<path d="M320 176H346V244H370" marker-end="url(#cs-arrow)"></path>
						<path d="M448 112V210" marker-end="url(#cs-arrow)"></path>
						<path d="M448 276V322" marker-end="url(#cs-arrow)"></path>
						<path d="M524 244H594" marker-end="url(#cs-arrow)"></path>
					</g>

					<g class="cs-d-edge-labels">
						<text x="172" y="152" text-anchor="middle">HTTPS</text>
						<text x="352" y="70">/</text>
						<text x="352" y="262">/api</text>
						<text x="456" y="166">fetch en el servidor</text>
						<text x="560" y="234" text-anchor="middle">SOAP</text>
					</g>

					<g class="cs-d-node">
						<rect x="16" y="130" width="130" height="64" rx="12"></rect>
						<text x="81" y="158" text-anchor="middle" class="cs-d-title"
							>Navegador</text
						>
						<text x="81" y="178" text-anchor="middle" class="cs-d-sub"
							>mostrador · admin</text
						>
					</g>

					<g class="cs-d-node">
						<rect x="200" y="130" width="120" height="64" rx="12"></rect>
						<text x="260" y="158" text-anchor="middle" class="cs-d-title"
							>Caddy</text
						>
						<text x="260" y="178" text-anchor="middle" class="cs-d-sub"
							>proxy · TLS</text
						>
					</g>

					<g class="cs-d-node">
						<rect x="372" y="48" width="152" height="64" rx="12"></rect>
						<text x="448" y="76" text-anchor="middle" class="cs-d-title"
							>Next.js</text
						>
						<text x="448" y="96" text-anchor="middle" class="cs-d-sub"
							>App Router · MUI</text
						>
					</g>

					<g class="cs-d-node cs-d-node--primary">
						<rect x="372" y="212" width="152" height="64" rx="12"></rect>
						<text x="448" y="240" text-anchor="middle" class="cs-d-title"
							>Django + DRF</text
						>
						<text x="448" y="260" text-anchor="middle" class="cs-d-sub"
							>API /api/v1</text
						>
					</g>

					<g class="cs-d-node">
						<rect x="372" y="324" width="152" height="56" rx="12"></rect>
						<text x="448" y="349" text-anchor="middle" class="cs-d-title"
							>PostgreSQL</text
						>
						<text x="448" y="367" text-anchor="middle" class="cs-d-sub"
							>datos y sesiones</text
						>
					</g>

					<g class="cs-d-node cs-d-node--external">
						<rect x="596" y="212" width="148" height="64" rx="12"></rect>
						<text x="670" y="240" text-anchor="middle" class="cs-d-title"
							>AFIP / ARCA</text
						>
						<text x="670" y="260" text-anchor="middle" class="cs-d-sub"
							>WSAA · WSFEv1 · Padrón</text
						>
					</g>
				</svg>
			</div>
		</figure>
	</section>

	<section class="cs-section" aria-labelledby="cs-decisiones">
		<h3 id="cs-decisiones" data-ui-heading="true">Decisiones técnicas</h3>
		<ul class="cs-grid cs-grid--two">
			{
				decisions.map((decision, index) => (
					<li class="ds-glass-panel cs-card">
						<span class="cs-card__number">
							{String(index + 1).padStart(2, '0')}
						</span>
						<h4>{decision.title}</h4>
						<p>{decision.detail}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section class="cs-section" aria-labelledby="cs-calidad">
		<h3 id="cs-calidad" data-ui-heading="true">Calidad y entrega</h3>
		<div class="ds-body cs-prose">
			<p>
				Cada cambio pasa por un pipeline de integración continua antes de llegar
				al comercio:
			</p>
			<ul class="cs-list">
				{quality.map((item) => <li>{item}</li>)}
			</ul>
		</div>
	</section>

	<footer class="cs-footer ds-glass-panel">
		<p class="ds-body">
			El código es privado. Si querés conocer más detalles del proyecto,
			escribime.
		</p>
		<div class="flex flex-wrap gap-3">
			<a href="mailto:facurodri00@gmail.com" class="ds-button ds-button-primary"
				>Escribime</a
			>
		</div>
	</footer>
</div>

<style>
	.cs-lede {
		max-width: 46rem;
		font-size: 1.1rem;
	}

	.cs-facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
		gap: 1rem 2rem;
		padding-block: 1.25rem;
		border-block: 1px solid var(--color-border);
	}

	.cs-facts dt {
		font-family: var(--font-heading);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-primary);
	}

	.cs-facts dd {
		margin-top: 0.3rem;
		color: var(--color-heading);
	}

	.cs-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.cs-stack li {
		padding: 0.25rem 0.7rem;
		border-radius: 999px;
		border: 1px solid rgba(0, 208, 132, 0.22);
		background: rgba(0, 208, 132, 0.08);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: color-mix(in srgb, var(--color-primary) 78%, white 22%);
	}

	.cs-stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
		gap: 1rem;
	}

	.cs-stats li {
		display: grid;
		gap: 0.25rem;
		padding: 1.25rem 1.4rem;
		border-radius: var(--radius-lg);
	}

	.cs-stats__value {
		font-family: var(--font-heading);
		font-size: clamp(2rem, 4vw, 2.6rem);
		font-weight: 700;
		line-height: 1;
		color: var(--color-heading);
	}

	.cs-stats__label {
		font-size: 0.9rem;
		color: var(--color-text-muted);
	}

	.cs-section {
		margin-top: clamp(2.75rem, 6vw, 3.75rem);
	}

	.cs-section h3 {
		margin-bottom: 1.25rem;
		font-family: var(--font-heading);
		font-size: clamp(1.6rem, 3vw, 2.1rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--color-heading);
	}

	.cs-prose {
		display: grid;
		gap: 1rem;
		max-width: 46rem;
	}

	.cs-list {
		display: grid;
		gap: 0.6rem;
	}

	.cs-list li {
		position: relative;
		padding-left: 1.2rem;
	}

	.cs-list li::before {
		content: '';
		position: absolute;
		left: 0.15rem;
		top: 0.65em;
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 999px;
		background: var(--color-primary);
	}

	.cs-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1rem;
	}

	.cs-grid--two {
		grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
	}

	.cs-card {
		display: grid;
		align-content: start;
		gap: 0.5rem;
		padding: 1.4rem;
		border-radius: var(--radius-lg);
	}

	.cs-card h4 {
		font-family: var(--font-heading);
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--color-heading);
	}

	.cs-card p {
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--color-text-muted);
		text-wrap: pretty;
	}

	.cs-card__number {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--color-primary);
	}

	.cs-diagram {
		margin-top: 1.75rem;
		padding: clamp(0.75rem, 3vw, 2rem);
		border-radius: var(--radius-lg);
	}

	.cs-diagram__scroll {
		overflow-x: auto;
	}

	.cs-diagram svg {
		display: block;
		width: 100%;
		min-width: 40rem;
		max-width: 52rem;
		margin-inline: auto;
		height: auto;
	}

	.cs-d-zone {
		fill: rgba(56, 189, 248, 0.04);
		stroke: rgba(56, 189, 248, 0.35);
		stroke-dasharray: 6 6;
	}

	.cs-d-zone-label {
		font-family: var(--font-mono);
		font-size: 13px;
		fill: var(--color-secondary);
	}

	.cs-d-edges path {
		fill: none;
		stroke: rgba(148, 163, 184, 0.6);
		stroke-width: 1.5;
	}

	.cs-d-arrowhead {
		fill: rgba(148, 163, 184, 0.8);
	}

	.cs-d-edge-labels text {
		font-family: var(--font-mono);
		font-size: 11px;
		fill: var(--color-text-muted);
	}

	.cs-d-node rect {
		fill: rgba(15, 23, 42, 0.92);
		stroke: rgba(148, 163, 184, 0.3);
		stroke-width: 1.2;
	}

	.cs-d-node--primary rect {
		stroke: var(--color-primary);
		fill: rgba(0, 208, 132, 0.08);
	}

	.cs-d-node--external rect {
		stroke: var(--color-secondary);
		stroke-dasharray: 4 4;
	}

	.cs-d-title {
		font-family: var(--font-heading);
		font-size: 15px;
		font-weight: 700;
		fill: var(--color-heading);
	}

	.cs-d-sub {
		font-family: var(--font-mono);
		font-size: 11px;
		fill: var(--color-text-muted);
	}

	.cs-footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		margin-top: clamp(2.75rem, 6vw, 3.75rem);
		padding: 1.5rem 1.75rem;
		border-radius: var(--radius-lg);
	}
</style>
