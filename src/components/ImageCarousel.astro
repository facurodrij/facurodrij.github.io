---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Slide {
	src: ImageMetadata;
	alt: string;
	caption: string;
}

interface Props {
	slides: Slide[];
	label: string;
}

const { slides, label } = Astro.props;
---

<div
	class="carousel"
	role="region"
	aria-roledescription="carrusel"
	aria-label={label}
	data-carousel
>
	<div
		class="carousel__viewport ds-glass-panel"
		data-carousel-track
		tabindex="0"
	>
		{
			slides.map((slide, index) => (
				<figure
					class="carousel__slide"
					role="group"
					aria-roledescription="diapositiva"
					aria-label={`${index + 1} de ${slides.length}: ${slide.caption}`}
					data-carousel-slide
				>
					<div class="carousel__frame">
						<Image
							src={slide.src}
							alt={slide.alt}
							widths={[640, 1024, 1440]}
							sizes="(min-width: 1152px) 70rem, 100vw"
							loading="lazy"
							class="carousel__image"
						/>
					</div>
				</figure>
			))
		}
	</div>

	<div class="carousel__controls">
		<p class="carousel__caption" aria-live="polite" data-carousel-caption>
			{slides[0]?.caption}
		</p>

		{
			slides.length > 1 && (
				<div class="carousel__nav">
					<button
						type="button"
						class="carousel__arrow ds-button ds-button-secondary ds-glass-button"
						aria-label="Imagen anterior"
						data-carousel-prev
					>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M15 6l-6 6 6 6" />
						</svg>
					</button>
					<div class="carousel__dots">
						{slides.map((slide, index) => (
							<button
								type="button"
								class="carousel__dot"
								aria-label={`Ver imagen ${index + 1}: ${slide.caption}`}
								aria-current={index === 0 ? 'true' : 'false'}
								data-carousel-dot={index}
								data-caption={slide.caption}
							/>
						))}
					</div>
					<button
						type="button"
						class="carousel__arrow ds-button ds-button-secondary ds-glass-button"
						aria-label="Imagen siguiente"
						data-carousel-next
					>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M9 6l6 6-6 6" />
						</svg>
					</button>
				</div>
			)
		}
	</div>
</div>

<script>
	// Manual-only carousel: slides change on click, swipe or arrow keys, never on a timer.
	const setupCarousels = () => {
		document
			.querySelectorAll<HTMLElement>('[data-carousel]')
			.forEach((root) => {
				if (root.dataset.carouselReady === 'true') return;
				root.dataset.carouselReady = 'true';

				const track = root.querySelector<HTMLElement>('[data-carousel-track]');
				const slides = Array.from(
					root.querySelectorAll<HTMLElement>('[data-carousel-slide]'),
				);
				const dots = Array.from(
					root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'),
				);
				const caption = root.querySelector<HTMLElement>(
					'[data-carousel-caption]',
				);
				const prev = root.querySelector<HTMLButtonElement>(
					'[data-carousel-prev]',
				);
				const next = root.querySelector<HTMLButtonElement>(
					'[data-carousel-next]',
				);
				if (!track || slides.length === 0) return;

				const reduceMotion = window.matchMedia(
					'(prefers-reduced-motion: reduce)',
				).matches;
				let current = 0;

				const render = (index: number) => {
					current = index;
					dots.forEach((dot, i) =>
						dot.setAttribute('aria-current', String(i === index)),
					);
					if (caption) caption.textContent = dots[index]?.dataset.caption ?? '';
					if (prev) prev.disabled = index === 0;
					if (next) next.disabled = index === slides.length - 1;
				};

				const goTo = (index: number) => {
					const target = Math.max(0, Math.min(index, slides.length - 1));
					track.scrollTo({
						left: slides[target].offsetLeft,
						behavior: reduceMotion ? 'auto' : 'smooth',
					});
					render(target);
				};

				prev?.addEventListener('click', () => goTo(current - 1));
				next?.addEventListener('click', () => goTo(current + 1));
				dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

				track.addEventListener('keydown', (event) => {
					if (event.key === 'ArrowLeft') {
						event.preventDefault();
						goTo(current - 1);
					}
					if (event.key === 'ArrowRight') {
						event.preventDefault();
						goTo(current + 1);
					}
				});

				// Keep dots and caption in sync when the user swipes the track.
				let scrollFrame = 0;
				track.addEventListener('scroll', () => {
					cancelAnimationFrame(scrollFrame);
					scrollFrame = requestAnimationFrame(() => {
						const index = Math.round(track.scrollLeft / track.clientWidth);
						if (index !== current) render(index);
					});
				});

				render(0);
			});
	};

	document.addEventListener('astro:page-load', setupCarousels);
</script>

<style>
	.carousel {
		display: grid;
		gap: 1rem;
	}

	.carousel__viewport {
		display: flex;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		border-radius: var(--radius-lg);
		outline: none;
	}

	.carousel__viewport::-webkit-scrollbar {
		display: none;
	}

	.carousel__viewport:focus-visible {
		box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.35);
	}

	.carousel__slide {
		flex: 0 0 100%;
		scroll-snap-align: start;
		padding: clamp(0.75rem, 2vw, 1.25rem);
	}

	.carousel__frame {
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: var(--radius-md);
		border: 1px solid var(--color-border);
		background: #f1f5f9;
	}

	.carousel__image {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.carousel__controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
	}

	.carousel__caption {
		flex: 1 1 18rem;
		font-size: 0.95rem;
		color: var(--color-text-muted);
	}

	.carousel__nav {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.carousel__arrow {
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border-radius: 999px;
	}

	.carousel__arrow svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.carousel__arrow:disabled {
		opacity: 0.4;
		pointer-events: none;
	}

	.carousel__dots {
		display: flex;
		gap: 0.5rem;
	}

	.carousel__dot {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 999px;
		background: rgba(148, 163, 184, 0.35);
		transition:
			width 200ms ease,
			background-color 200ms ease;
	}

	.carousel__dot[aria-current='true'] {
		width: 1.5rem;
		background: var(--color-primary);
	}

	.carousel__dot:focus-visible {
		outline: 2px solid var(--color-secondary);
		outline-offset: 2px;
	}
</style>
