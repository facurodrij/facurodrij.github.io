---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Slide {
	src: ImageMetadata;
	alt: string;
	caption: string;
}

interface Props {
	slides: Slide[];
	label: string;
	/** Caption of the optional last slide passed in the "extra" slot (e.g. a diagram). */
	extraCaption?: string;
	eager?: boolean;
}

const { slides, label, extraCaption, eager = false } = Astro.props;
const hasExtra = Astro.slots.has('extra');
const total = slides.length + (hasExtra ? 1 : 0);
---

<div
	class="carousel"
	role="region"
	aria-roledescription="carrusel"
	aria-label={label}
	data-carousel
>
	<div class="carousel__viewport" tabindex="0" data-carousel-viewport>
		<div class="carousel__track" data-carousel-track>
			{
				slides.map((slide, index) => (
					<figure
						class="carousel__slide"
						role="group"
						aria-roledescription="diapositiva"
						aria-label={`${index + 1} de ${total}`}
						data-carousel-slide
						data-caption={slide.caption}
					>
						<Image
							src={slide.src}
							alt={slide.alt}
							widths={[640, 1024, 1440, 1920]}
							sizes="(min-width: 768px) 34rem, 100vw"
							loading={eager && index === 0 ? 'eager' : 'lazy'}
							class="carousel__image"
						/>
					</figure>
				))
			}
			{
				hasExtra && (
					<figure
						class="carousel__slide carousel__slide--extra"
						role="group"
						aria-roledescription="diapositiva"
						aria-label={`${total} de ${total}`}
						data-carousel-slide
						data-caption={extraCaption}
					>
						<slot name="extra" />
					</figure>
				)
			}
		</div>

		{
			total > 1 && (
				<>
					<button
						type="button"
						class="carousel__arrow carousel__arrow--prev"
						aria-label="Imagen anterior"
						data-carousel-prev
					>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M15 6l-6 6 6 6" />
						</svg>
					</button>
					<button
						type="button"
						class="carousel__arrow carousel__arrow--next"
						aria-label="Imagen siguiente"
						data-carousel-next
					>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M9 6l6 6-6 6" />
						</svg>
					</button>
				</>
			)
		}
	</div>

	{total > 1 && <div class="carousel__dots" data-carousel-dots />}
	<p class="sr-only" aria-live="polite" data-carousel-status></p>

	<dialog
		class="lightbox"
		aria-label={`${label}, imagen ampliada`}
		data-carousel-lightbox
	>
		<div class="lightbox__top">
			<button
				type="button"
				class="lightbox__close"
				aria-label="Cerrar imagen ampliada"
				data-lightbox-close
			>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M6 6l12 12M18 6L6 18"></path>
				</svg>
			</button>
		</div>
		<div class="lightbox__stage">
			<div class="lightbox__media" data-lightbox-media></div>
			{
				total > 1 && (
					<>
						<button
							type="button"
							class="carousel__arrow carousel__arrow--prev"
							aria-label="Imagen anterior"
							data-lightbox-prev
						>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M15 6l-6 6 6 6" />
							</svg>
						</button>
						<button
							type="button"
							class="carousel__arrow carousel__arrow--next"
							aria-label="Imagen siguiente"
							data-lightbox-next
						>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M9 6l6 6-6 6" />
							</svg>
						</button>
					</>
				)
			}
		</div>
		{total > 1 && <div class="carousel__dots" data-lightbox-dots />}
	</dialog>
</div>

<script>
	// Manual-only carousel: slides change on click, swipe or arrow keys, never on a timer.
	// A click or Enter on the image opens it large in a lightbox that stays in sync.
	const makeDots = (
		container: HTMLElement | null,
		count: number,
		onSelect: (index: number) => void,
	) => {
		if (!container) return [];
		const dots = Array.from({ length: count }, (_, index) => {
			const dot = document.createElement('button');
			dot.type = 'button';
			dot.className = 'carousel__dot';
			dot.setAttribute('aria-label', `Ir a la imagen ${index + 1}`);
			dot.addEventListener('click', () => onSelect(index));
			return dot;
		});
		container.replaceChildren(...dots);
		return dots;
	};

	const onSwipe = (element: HTMLElement, onStep: (step: number) => void) => {
		let startX: number | null = null;
		element.addEventListener(
			'touchstart',
			(event) => (startX = event.touches[0].clientX),
			{ passive: true },
		);
		element.addEventListener('touchend', (event) => {
			if (startX === null) return;
			const dx = event.changedTouches[0].clientX - startX;
			if (Math.abs(dx) > 40) onStep(dx < 0 ? 1 : -1);
			startX = null;
		});
	};

	const setupCarousels = () => {
		document
			.querySelectorAll<HTMLElement>('[data-carousel]')
			.forEach((root) => {
				if (root.dataset.carouselReady === 'true') return;
				root.dataset.carouselReady = 'true';

				const viewport = root.querySelector<HTMLElement>(
					'[data-carousel-viewport]',
				);
				const track = root.querySelector<HTMLElement>('[data-carousel-track]');
				const status = root.querySelector<HTMLElement>(
					'[data-carousel-status]',
				);
				const lightbox = root.querySelector<HTMLDialogElement>(
					'[data-carousel-lightbox]',
				);
				const lightboxMedia = root.querySelector<HTMLElement>(
					'[data-lightbox-media]',
				);
				const slides = Array.from(
					root.querySelectorAll<HTMLElement>('[data-carousel-slide]'),
				);
				if (!viewport || !track || !lightbox || !lightboxMedia) return;
				if (slides.length === 0) return;

				let current = 0;
				const wrap = (index: number) => (index + slides.length) % slides.length;
				const describe = (index: number) =>
					`Imagen ${index + 1} de ${slides.length}: ${slides[index].dataset.caption ?? ''}`;

				const dots = makeDots(
					root.querySelector('[data-carousel-dots]'),
					slides.length,
					(index) => goTo(index),
				);
				const lightboxDots = makeDots(
					lightbox.querySelector('[data-lightbox-dots]'),
					slides.length,
					(index) => showLarge(index),
				);

				const goTo = (index: number) => {
					current = wrap(index);
					track.style.transform = `translateX(-${current * 100}%)`;
					slides.forEach((slide, i) => (slide.inert = i !== current));
					dots.forEach((dot, i) =>
						dot.setAttribute('aria-current', String(i === current)),
					);
					if (status) status.textContent = describe(current);
				};

				const showLarge = (index: number) => {
					goTo(index);
					const clone = slides[current].firstElementChild?.cloneNode(true);
					if (clone instanceof HTMLImageElement) {
						clone.loading = 'eager';
						// Let the browser pick the largest rendition for a full-screen view.
						clone.sizes = '100vw';
					}
					lightboxMedia.replaceChildren(...(clone ? [clone] : []));
					lightboxDots.forEach((dot, i) =>
						dot.setAttribute('aria-current', String(i === current)),
					);
				};

				const openLarge = () => {
					showLarge(current);
					lightbox.showModal();
					lightbox.querySelector<HTMLElement>('[data-lightbox-close]')?.focus();
				};

				root
					.querySelector('[data-carousel-prev]')
					?.addEventListener('click', () => goTo(current - 1));
				root
					.querySelector('[data-carousel-next]')
					?.addEventListener('click', () => goTo(current + 1));
				viewport.addEventListener('keydown', (event) => {
					if (event.key === 'ArrowLeft') goTo(current - 1);
					if (event.key === 'ArrowRight') goTo(current + 1);
					if (event.key === 'Enter' && event.target === viewport) openLarge();
				});

				// A tap opens the lightbox; a swipe only changes the slide.
				let swiped = false;
				viewport.addEventListener('touchmove', () => (swiped = true), {
					passive: true,
				});
				onSwipe(viewport, (step) => goTo(current + step));
				track.addEventListener('click', () => {
					if (swiped) {
						swiped = false;
						return;
					}
					openLarge();
				});
				viewport.addEventListener('touchend', () =>
					setTimeout(() => (swiped = false), 50),
				);

				lightbox
					.querySelector('[data-lightbox-close]')
					?.addEventListener('click', () => lightbox.close());
				lightbox
					.querySelector('[data-lightbox-prev]')
					?.addEventListener('click', () => showLarge(current - 1));
				lightbox
					.querySelector('[data-lightbox-next]')
					?.addEventListener('click', () => showLarge(current + 1));
				lightbox.addEventListener('keydown', (event) => {
					if (event.key === 'ArrowLeft') showLarge(current - 1);
					if (event.key === 'ArrowRight') showLarge(current + 1);
				});
				onSwipe(lightbox, (step) => showLarge(current + step));
				// Clicking anywhere but the image or the controls closes it.
				lightbox.addEventListener('click', (event) => {
					const target = event.target;
					if (!(target instanceof Element)) return;
					if (
						target === lightbox ||
						target.matches('.lightbox__top, .lightbox__stage, .lightbox__media')
					) {
						lightbox.close();
					}
				});
				lightbox.addEventListener('close', () => {
					lightboxMedia.replaceChildren();
					viewport.focus({ preventScroll: true });
				});

				goTo(0);
			});
	};

	document.addEventListener('astro:page-load', setupCarousels);
</script>

<style>
	.carousel {
		display: grid;
		gap: 0.85rem;
		min-width: 0;
	}

	.carousel__viewport {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-md);
		border: 1px solid var(--color-border);
		background: var(--color-bg-elevated);
		outline: none;
		transition:
			transform 500ms ease,
			box-shadow 500ms ease;
	}

	.carousel__viewport:focus-visible {
		box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.35);
	}

	.carousel__track {
		display: flex;
		transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.carousel__slide {
		display: grid;
		flex: 0 0 100%;
		place-items: center;
		aspect-ratio: 16 / 9;
		margin: 0;
		background: #0b1220;
		cursor: zoom-in;
	}

	.carousel__slide--extra {
		padding: 0.5rem 3.25rem;
		background:
			radial-gradient(
				circle at 50% 40%,
				rgba(8, 24, 56, 0.6),
				rgba(2, 6, 23, 0) 70%
			),
			#060c1a;
	}

	.carousel__image {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	/* Arrows sit on the image: quiet at rest, clear on hover or keyboard focus. */
	.carousel__arrow {
		position: absolute;
		top: 50%;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 2.4rem;
		height: 2.4rem;
		padding: 0;
		border-radius: 999px;
		border: 1px solid rgba(248, 250, 252, 0.16);
		background: rgba(2, 6, 23, 0.62);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		color: var(--color-heading);
		box-shadow: 0 8px 22px rgba(2, 6, 23, 0.45);
		cursor: pointer;
		opacity: 0.55;
		transform: translateY(-50%);
		transition:
			opacity 200ms ease,
			background-color 200ms ease,
			border-color 200ms ease,
			color 200ms ease,
			transform 200ms ease;
	}

	.carousel__arrow--prev {
		left: 0.75rem;
	}

	.carousel__arrow--next {
		right: 0.75rem;
	}

	.carousel__arrow svg,
	.lightbox__close svg {
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.carousel__viewport:hover .carousel__arrow,
	.carousel__arrow:focus-visible {
		opacity: 1;
	}

	.carousel__arrow:hover {
		border-color: rgba(0, 208, 132, 0.5);
		background: rgba(2, 6, 23, 0.82);
		color: var(--color-primary);
		transform: translateY(-50%) scale(1.06);
	}

	.carousel__arrow:focus-visible,
	.lightbox__close:focus-visible {
		outline: 2px solid var(--color-secondary);
		outline-offset: 2px;
	}

	@media (hover: none) {
		.carousel__arrow {
			opacity: 0.9;
		}
	}

	.carousel__dots {
		display: flex;
		justify-content: center;
		gap: 0.4rem;
	}

	.carousel__dots :global(.carousel__dot) {
		width: 0.5rem;
		height: 0.5rem;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: rgba(148, 163, 184, 0.35);
		cursor: pointer;
		transition:
			width 300ms cubic-bezier(0.22, 1, 0.36, 1),
			background-color 200ms ease;
	}

	.carousel__dots :global(.carousel__dot[aria-current='true']) {
		width: 1.4rem;
		background: var(--color-primary);
	}

	.carousel__dots :global(.carousel__dot:focus-visible) {
		outline: 2px solid var(--color-secondary);
		outline-offset: 2px;
	}

	/* ---------- Lightbox: the image as large as the screen allows ---------- */
	:global(html:has(.lightbox[open])) {
		overflow: hidden;
	}

	.lightbox {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		margin: 0;
		padding-block: max(14px, env(safe-area-inset-top, 0px))
			max(18px, env(safe-area-inset-bottom, 0px));
		padding-inline: max(16px, env(safe-area-inset-left, 0px))
			max(16px, env(safe-area-inset-right, 0px));
		border: 0;
		background: transparent;
		color: var(--color-text);
	}

	.lightbox[open] {
		display: grid;
		grid-template-rows: auto minmax(0, 1fr) auto;
		gap: 0.75rem;
	}

	.lightbox::backdrop {
		background: rgba(2, 6, 23, 0.9);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}

	.lightbox__top {
		display: flex;
		justify-content: flex-end;
	}

	.lightbox__close {
		display: grid;
		place-items: center;
		width: 2.6rem;
		height: 2.6rem;
		padding: 0;
		border-radius: 999px;
		border: 1px solid rgba(248, 250, 252, 0.16);
		background: rgba(2, 6, 23, 0.62);
		color: var(--color-heading);
		cursor: pointer;
	}

	.lightbox__close:hover {
		border-color: rgba(0, 208, 132, 0.5);
		color: var(--color-primary);
	}

	.lightbox__stage {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 0;
	}

	.lightbox__media {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		min-height: 0;
		padding-inline: 3.5rem;
	}

	.lightbox__media > :global(*) {
		animation: lightbox-in 280ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.lightbox__media :global(img) {
		width: auto;
		height: auto;
		max-width: min(100%, 1400px);
		max-height: calc(100dvh - 9rem);
		object-fit: contain;
		border-radius: var(--radius-md);
		box-shadow: 0 30px 90px rgba(0, 0, 0, 0.55);
	}

	.lightbox__media :global(svg) {
		width: min(100%, 1200px);
		height: auto;
		max-height: calc(100dvh - 9rem);
		padding: clamp(0.75rem, 3vw, 2rem);
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		background: #060c1a;
	}

	.lightbox .carousel__arrow {
		opacity: 1;
	}

	@keyframes lightbox-in {
		from {
			opacity: 0;
			transform: scale(0.96);
		}

		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (max-width: 600px) {
		.lightbox__media {
			padding-inline: 0;
		}

		/* On phones the arrows move down next to the dots so they don't cover the image. */
		.lightbox .carousel__arrow {
			top: auto;
			bottom: -3.1rem;
			transform: none;
		}

		.lightbox .carousel__arrow:hover {
			transform: none;
		}
	}
</style>
