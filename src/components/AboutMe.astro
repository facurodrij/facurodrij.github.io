---
---

<article class="mx-auto max-w-6xl">
	<div class="grid gap-4 lg:grid-cols-12 lg:gap-5">
		<div class="grid gap-4 lg:col-span-4 lg:grid-rows-[minmax(0,1.35fr)_minmax(0,0.9fr)] lg:gap-5">
			<section class="aboutme-panel aboutme-panel-hero">
				<div class="flex items-start justify-between gap-4">
					<div>
						<p class="aboutme-panel-label">Formación</p>
					</div>
					<span class="aboutme-dot mt-1"></span>
				</div>
			</section>

			<section class="aboutme-panel aboutme-location-panel"></section>
		</div>

		<section class="aboutme-panel lg:col-span-8">
			<div class="flex justify-center">
				<span class="aboutme-kicker">Cómo trabajo</span>
			</div>
		</section>
	</div>
</article>

<style>
	.aboutme-panel {
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 100%;
		padding: 1.5rem;
		border-radius: clamp(1.25rem, 2vw, 1.75rem);
		border: 1px solid rgba(148, 163, 184, 0.12);
		background:
			radial-gradient(circle at top, rgba(255, 255, 255, 0.05), transparent 38%),
			linear-gradient(180deg, rgba(17, 24, 39, 0.94), rgba(12, 18, 32, 0.92));
		box-shadow:
			0 24px 60px rgba(2, 6, 23, 0.32),
			inset 0 1px 0 rgba(255, 255, 255, 0.05);
	}

	.aboutme-panel::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(135deg, rgba(139, 92, 246, 0.08), transparent 36%);
		opacity: 0.9;
	}

	.aboutme-panel > * {
		position: relative;
		z-index: 1;
	}

	.aboutme-panel-hero {
		min-height: 19rem;
	}

	.aboutme-location-panel {
		justify-content: flex-end;
		min-height: 11.5rem;
		padding: 1.15rem 1.25rem;
		border-color: rgba(255, 255, 255, 0.08);
		background: linear-gradient(180deg, rgba(7, 11, 18, 0.46), rgba(7, 11, 18, 0.86));
		box-shadow:
			0 22px 48px rgba(2, 6, 23, 0.28),
			inset 0 1px 0 rgba(255, 255, 255, 0.03);
	}

	.aboutme-location-panel::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(8, 10, 18, 0.26), rgba(8, 10, 18, 0.82)),
			radial-gradient(circle at 50% 16%, rgba(255, 255, 255, 0.08), transparent 48%),
			url('/posadas.jpg') center center / cover no-repeat;
		filter: grayscale(1) contrast(1.02) brightness(0.88);
		transform: scale(1.01);
	}

	.aboutme-location-panel::after {
		background:
			linear-gradient(180deg, rgba(10, 12, 20, 0.06), rgba(10, 12, 20, 0.78)),
			linear-gradient(135deg, rgba(255, 255, 255, 0.04), transparent 42%);
		opacity: 1;
	}

	.aboutme-panel-label {
		font-family: var(--font-heading);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.aboutme-kicker {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.7rem 1.25rem;
		border-radius: 999px;
		border: 1px solid rgba(139, 92, 246, 0.18);
		background: rgba(17, 24, 39, 0.72);
		font-family: var(--font-heading);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: #a855f7;
	}

	.aboutme-dot {
		width: 0.72rem;
		height: 0.72rem;
		border-radius: 999px;
		background: var(--color-primary);
		box-shadow: 0 0 18px rgba(0, 208, 132, 0.48);
	}

	@media (min-width: 768px) {
		.aboutme-panel {
			padding: 1.75rem;
		}

		.aboutme-location-panel {
			padding: 1.35rem 1.5rem;
		}
	}

	@media (min-width: 1024px) {
		.aboutme-panel {
			min-height: 18rem;
		}

		.aboutme-panel-hero {
			min-height: 18rem;
		}

		.aboutme-location-panel {
			min-height: 12rem;
		}
	}
</style>
