---
const currentPipeline = [
	{
		label: 'Desarrollo',
		detail:
			'Construyo producto con foco en DX, mantenibilidad y entrega continua.',
	},
	{
		label: 'Automatizacion',
		detail:
			'Convierto tareas repetitivas en flujos confiables, bots y procesos medibles.',
	},
	{
		label: 'Infraestructura',
		detail: 'Diseño entornos reproducibles, observables y listos para escalar.',
	},
	{
		label: 'Escalabilidad',
		detail:
			'Llevo servicios a produccion con resiliencia, performance y criterio operativo.',
	},
];

const mindsetPrinciples = [
	{
		number: '01',
		title: 'Claridad primero',
		detail:
			'Reducir ruido, nombrar bien y dejar caminos de mantenimiento simples.',
	},
	{
		number: '02',
		title: 'Entrega concreta',
		detail:
			'Iterar con alcance chico, validar rapido y cuidar el impacto real.',
	},
	{
		number: '03',
		title: 'Criterio operativo',
		detail: 'Pensar en errores, trazabilidad y performance desde el inicio.',
	},
];

const hobbies = [
	{
		label: 'Futbol',
		image: '/aboutme/futbol.jpeg',
		alt: 'Foto de futbol',
		angle: -12,
	},
	{
		label: 'Relax',
		image: '/aboutme/playa.jpeg',
		alt: 'Foto en la playa',
		angle: 9,
	},
	{
		label: 'Viajes',
		image: '/aboutme/viajes.jpeg',
		alt: 'Foto de viaje',
		angle: -7,
	},
	{
		label: 'Asados',
		image: '/aboutme/asado.jpeg',
		alt: 'Foto de asado',
		angle: 13,
	},
];

const hobbiesCount = hobbies.length;
---

<article class="mx-auto max-w-6xl">
	<div class="grid gap-4 lg:grid-cols-12 lg:gap-5">
		<div class="aboutme-side-panels grid gap-4 lg:col-span-4 lg:gap-5">
			<section class="aboutme-panel aboutme-panel-hero">
				<p class="aboutme-panel-label">Formación</p>

				<div class="aboutme-education-list">
					<article class="aboutme-education-item">
						<div class="aboutme-education-copy">
							<h3 class="aboutme-education-title">
								Universidad Nacional de Misiones
							</h3>
							<p class="aboutme-education-degree">
								Licenciatura en Sistemas de Información
							</p>
						</div>

						<div class="aboutme-education-meta">
							<p class="aboutme-education-location">Misiones - Argentina</p>
							<p class="aboutme-education-dates">Feb. 2019 - Jun. 2024</p>
						</div>
					</article>

					<article class="aboutme-education-item">
						<div class="aboutme-education-copy">
							<h3 class="aboutme-education-title">
								Universidad Nacional de Misiones
							</h3>
							<p class="aboutme-education-degree">
								Analista en Sistemas de Computación
							</p>
						</div>

						<div class="aboutme-education-meta">
							<p class="aboutme-education-location">Misiones - Argentina</p>
							<p class="aboutme-education-dates">Feb. 2019 - Mar. 2023</p>
						</div>
					</article>
				</div>
			</section>

			<section class="aboutme-panel aboutme-location-panel">
				<div class="aboutme-location-content">
					<h3 class="aboutme-location-title">Posadas, Argentina</h3>
					<p class="aboutme-location-coordinates">27.3671° S, 55.8961° W</p>
					<p class="aboutme-location-timezone">- UTC-3</p>
				</div>
			</section>
		</div>

		<div class="aboutme-summary-panels lg:col-span-8">
			<section
				class="aboutme-panel aboutme-summary-panel aboutme-summary-panel-wide aboutme-summary-panel-pipeline"
			>
				<p class="aboutme-panel-label">Hoy me mueve</p>
				<div
					class="aboutme-pipeline"
					aria-label="Pipeline de intereses actuales"
				>
					{
						currentPipeline.map((item) => (
							<article class="aboutme-pipeline-step" tabindex="0">
								<div class="aboutme-pipeline-step-copy">
									<h3 class="aboutme-pipeline-step-label">{item.label}</h3>
									<p class="aboutme-pipeline-step-detail">{item.detail}</p>
								</div>
							</article>
						))
					}
				</div>
			</section>

			<section
				class="aboutme-panel aboutme-summary-panel aboutme-summary-panel-tall aboutme-mindset-panel"
			>
				<p class="aboutme-panel-label">Mentalidad</p>

				<div class="aboutme-mindset-principles">
					{
						mindsetPrinciples.map((item) => (
							<article class="aboutme-mindset-principle">
								<span class="aboutme-mindset-principle-number">
									{item.number}
								</span>
								<div class="aboutme-mindset-principle-copy">
									<h3>{item.title}</h3>
									<p>{item.detail}</p>
								</div>
							</article>
						))
					}
				</div>
			</section>

			<section
				class="aboutme-panel aboutme-summary-panel aboutme-summary-panel-tall aboutme-summary-panel-hobbies"
			>
				<p class="aboutme-panel-label">Hobbies</p>

				<div
					class="aboutme-hobby-stack relative isolate mx-auto flex w-full max-w-full flex-1 flex-col items-center justify-end py-2 sm:py-3 text-slate-100"
					data-aboutme-stack
					tabindex="0"
					role="region"
					aria-label="Carousel de hobbies"
					style={`--n:${hobbiesCount}; --k:0`}
				>
					<div
						class="aboutme-hobby-stage relative grid w-full justify-items-center"
						data-stack-stage
						role="button"
						tabindex="-1"
						aria-label="Ver siguiente hobby"
					>
						{
							hobbies.map((hobby, index) => (
								<article
									class="aboutme-hobby-card pointer-events-none grid"
									data-stack-item
									style={`--i:${index}; --a:${hobby.angle}deg; z-index:${hobbiesCount - index}`}
									aria-hidden={index === 0 ? 'false' : 'true'}
								>
									<img
										class="aboutme-hobby-image h-56 w-56 max-w-full rounded-[1.4rem] border border-white/10 object-cover shadow-[0_18px_40px_rgba(2,6,23,0.38)] sm:h-[16rem] sm:w-[16rem]"
										src={hobby.image}
										alt={hobby.alt}
										loading={index === 0 ? 'eager' : 'lazy'}
									/>
									<h2 class="aboutme-hobby-title text-right text-xl font-semibold tracking-[-0.04em] text-white/95 sm:text-[1.65rem]">
										{hobby.label}
									</h2>
								</article>
							))
						}
					</div>
				</div>
			</section>
		</div>
	</div>
</article>

<script is:inline>
	document.querySelectorAll('[data-aboutme-stack]').forEach((stack) => {
		const stackStyle = stack.style;
		const total = Number(stackStyle.getPropertyValue('--n')) || 0;
		const stage = stack.querySelector('[data-stack-stage]');
		const cards = Array.from(stack.querySelectorAll('[data-stack-item]'));
		const autoplayDelay = 5000;
		const animationDuration = 800;

		if (!total || cards.length === 0 || !stage) return;

		let current = Number(stackStyle.getPropertyValue('--k')) || 0;
		let locked = false;
		let autoplayTimer;

		const syncState = () => {
			cards.forEach((card, index) => {
				const order = (index - current + total) % total;
				card.style.zIndex = String(total - order);
				card.setAttribute('aria-hidden', String(index !== current));
			});
		};

		const goTo = (increment) => {
			if (locked) return;

			locked = true;
			current = (current + increment + total) % total;
			stackStyle.setProperty('--k', String(current));
			syncState();

			window.setTimeout(() => {
				locked = false;
				syncState();
			}, animationDuration);
		};

		const stopAutoplay = () => {
			if (autoplayTimer) {
				window.clearTimeout(autoplayTimer);
			}
		};

		const startAutoplay = () => {
			stopAutoplay();
			autoplayTimer = window.setTimeout(() => {
				goTo(1);
				startAutoplay();
			}, autoplayDelay);
		};

		const advanceAndRestart = (increment) => {
			goTo(increment);
			startAutoplay();
		};

		stage.addEventListener('click', () => {
			advanceAndRestart(1);
		});

		stack.addEventListener('keydown', (event) => {
			if (event.key === 'Enter' || event.key === ' ') {
				event.preventDefault();
				advanceAndRestart(1);
			}

			if (event.key === 'ArrowLeft') {
				event.preventDefault();
				advanceAndRestart(-1);
			}

			if (event.key === 'ArrowRight') {
				event.preventDefault();
				advanceAndRestart(1);
			}
		});

		syncState();
		startAutoplay();
	});
</script>

<style>
	@property --p {
		syntax: '<number>';
		initial-value: 0;
		inherits: true;
	}

	@property --v {
		syntax: '<number>';
		initial-value: 0;
		inherits: true;
	}

	.aboutme-panel {
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 100%;
		padding: 1.5rem;
		border-radius: clamp(1.25rem, 2vw, 1.75rem);
		border: 1px solid rgba(148, 163, 184, 0.12);
		background:
			radial-gradient(
				circle at top,
				rgba(255, 255, 255, 0.05),
				transparent 38%
			),
			linear-gradient(180deg, rgba(17, 24, 39, 0.94), rgba(12, 18, 32, 0.92));
		box-shadow:
			0 24px 60px rgba(2, 6, 23, 0.32),
			inset 0 1px 0 rgba(255, 255, 255, 0.05);
	}

	.aboutme-panel::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(
			135deg,
			rgba(139, 92, 246, 0.08),
			transparent 36%
		);
		opacity: 0.9;
	}

	.aboutme-panel > * {
		position: relative;
		z-index: 1;
	}

	.aboutme-panel-hero {
		justify-content: flex-start;
		gap: 1.35rem;
		min-height: auto;
	}

	.aboutme-side-panels {
		align-content: start;
	}

	.aboutme-summary-panels {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.95rem;
		align-content: start;
		align-self: stretch;
	}

	.aboutme-summary-panel {
		justify-content: flex-start;
		gap: 1.25rem;
		min-height: 9.5rem;
	}

	.aboutme-summary-panel-hobbies {
		gap: 0.35rem;
	}

	.aboutme-summary-panel-pipeline {
		padding-bottom: 0;
		gap: 0.6rem;
	}

	.aboutme-summary-copy {
		max-width: 24ch;
		font-family: var(--font-heading);
		font-size: clamp(1.25rem, 2vw, 1.75rem);
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: -0.03em;
		color: var(--color-heading);
		text-wrap: balance;
	}

	.aboutme-mindset-panel {
		isolation: isolate;
		gap: 1.2rem;
		justify-content: flex-start;
		background:
			radial-gradient(
				circle at 76% 8%,
				rgba(56, 189, 248, 0.13),
				transparent 32%
			),
			radial-gradient(
				circle at 14% 94%,
				rgba(0, 208, 132, 0.12),
				transparent 34%
			),
			linear-gradient(180deg, rgba(17, 24, 39, 0.96), rgba(8, 13, 24, 0.94));
	}

	.aboutme-mindset-panel::before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background-image:
			linear-gradient(rgba(148, 163, 184, 0.06) 1px, transparent 1px),
			linear-gradient(90deg, rgba(148, 163, 184, 0.06) 1px, transparent 1px);
		background-size: 3.25rem 3.25rem;
		mask-image: linear-gradient(
			180deg,
			rgba(0, 0, 0, 0.7),
			rgba(0, 0, 0, 0.18) 74%,
			transparent
		);
		opacity: 0.7;
	}

	.aboutme-mindset-principles {
		display: grid;
		gap: 0.6rem;
		flex: 1;
		align-content: stretch;
	}

	.aboutme-mindset-principle {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: start;
		gap: 0.72rem;
		padding: 0.72rem;
		border-radius: var(--radius-md);
		border: 1px solid rgba(148, 163, 184, 0.11);
		background:
			linear-gradient(90deg, rgba(15, 23, 42, 0.74), rgba(15, 23, 42, 0.22)),
			rgba(2, 6, 23, 0.14);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
	}

	.aboutme-mindset-principle-number {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: var(--radius-sm);
		background: rgba(0, 208, 132, 0.1);
		border: 1px solid rgba(0, 208, 132, 0.18);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 700;
		line-height: 1;
		color: var(--color-primary);
	}

	.aboutme-mindset-principle-copy {
		display: grid;
		gap: 0.16rem;
		min-width: 0;
	}

	.aboutme-mindset-principle-copy h3 {
		font-family: var(--font-heading);
		font-size: 0.96rem;
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: 0;
		color: var(--color-heading);
	}

	.aboutme-mindset-principle-copy p {
		font-size: 0.78rem;
		line-height: 1.45;
		color: rgba(203, 213, 225, 0.68);
		text-wrap: pretty;
	}

	.aboutme-pipeline {
		position: relative;
		display: grid;
		gap: 0.85rem;
		max-width: 100%;
		margin-top: 0.25rem;
		align-items: end;
	}

	.aboutme-pipeline-step {
		position: relative;
		display: grid;
		align-content: start;
		gap: 0.9rem;
		padding: 0.8rem;
		border-radius: 1.15rem;
		border: 1px solid rgba(148, 163, 184, 0.14);
		background: linear-gradient(
			180deg,
			rgba(13, 20, 33, 0.96),
			rgba(9, 14, 24, 0.98)
		);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.04),
			0 16px 34px rgba(2, 6, 23, 0.18);
		overflow: hidden;
		transition:
			transform 220ms ease,
			border-color 220ms ease,
			box-shadow 220ms ease;
		z-index: 1;
	}

	.aboutme-pipeline-step::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 0;
		pointer-events: none;
		transition:
			opacity 220ms ease,
			height 220ms ease;
	}

	.aboutme-pipeline-step-copy {
		display: grid;
		gap: 0.45rem;
	}

	.aboutme-pipeline-step-label {
		font-family: var(--font-heading);
		font-size: clamp(0.92rem, 1vw, 1.04rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: var(--color-heading);
	}

	.aboutme-pipeline-step-detail {
		font-size: 0.7rem;
		line-height: 1.4;
		color: rgba(203, 213, 225, 0.72);
	}

	.aboutme-pipeline-step:focus-visible {
		outline: none;
		border-color: rgba(56, 189, 248, 0.32);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.04),
			0 18px 34px rgba(2, 6, 23, 0.22),
			0 0 0 1px rgba(56, 189, 248, 0.2);
	}

	.aboutme-hobby-stack {
		--p: var(--k);
		--abs-p: abs(var(--k) - var(--p));
		--end: clamp(0, calc(var(--abs-p) - 1), 1);
		--dir: calc((1 - 2 * var(--end)) * sign(var(--k) - var(--p)));
		--fwd: calc(0.5 * (1 + var(--dir)));
		--v: var(--k);
		--abs-v: abs(var(--v) - var(--p));
		--prg: calc(var(--abs-v) / (1 - var(--end) + var(--end) * (var(--n) - 1)));
		flex: 1 1 auto;
		min-height: 0;
		transition:
			--p 0s 0.8s,
			--v 0.8s;
	}

	.aboutme-hobby-stack:focus-visible {
		outline: none;
		box-shadow: 0 0 0 1px rgba(56, 189, 248, 0.24);
		border-radius: 1.25rem;
	}

	.aboutme-hobby-stage {
		min-height: 0;
		align-items: start;
		cursor: pointer;
	}

	.aboutme-hobby-card {
		--abs-top: abs(var(--k) - var(--i));
		--not-top: min(1, var(--abs-top));
		--top: calc(1 - var(--not-top));
		--val-mov: calc(
			(1 - var(--fwd)) * var(--p) + var(--fwd) * var(--k) - var(--i)
		);
		--abs-mov: abs(var(--val-mov));
		--not-mov: min(1, var(--abs-mov));
		--mov: calc(1 - var(--not-mov));
		position: relative;
		grid-area: 1 / 1;
		place-items: center;
		width: fit-content;
		max-width: 100%;
		height: fit-content;
	}

	.aboutme-hobby-title {
		translate: 0 calc(var(--not-top) * 1lh);
		opacity: var(--top);
		transition:
			translate 0.4s calc(var(--top) * 0.4s),
			opacity 0.4s calc(var(--top) * 0.4s);
		text-wrap: balance;
	}

	.aboutme-hobby-image {
		--sin: sin(calc(var(--prg) * 0.5turn));
		grid-area: 1 / 1;
		justify-self: center;
		translate: calc(-150% * var(--mov) * sqrt(var(--sin)));
		rotate: calc((1 - var(--sin)) * var(--a));
		filter: saturate(0.9) contrast(1.02) brightness(0.92);
	}

	.aboutme-hobby-title {
		position: absolute;
		z-index: 2;
		display: inline-block;
		isolation: isolate;
		right: 0.2rem;
		bottom: 0.4rem;
		grid-area: 1 / 1;
		max-width: 8ch;
		padding: 0.08em 0.18em;
		margin-top: 0;
		line-height: 0.95;
		text-shadow:
			0 2px 8px rgba(2, 6, 23, 0.92),
			0 10px 28px rgba(2, 6, 23, 0.78),
			0 0 24px rgba(2, 6, 23, 0.52);
	}

	.aboutme-hobby-title::before {
		content: '';
		position: absolute;
		z-index: -1;
		inset: -0.45em -0.65em;
		border-radius: 999px;
		background: radial-gradient(
			circle,
			rgba(2, 6, 23, 0.92) 0%,
			rgba(2, 6, 23, 0.72) 42%,
			rgba(2, 6, 23, 0.36) 68%,
			rgba(2, 6, 23, 0) 100%
		);
		filter: blur(12px);
		opacity: 0.95;
		pointer-events: none;
	}

	@supports not (scale: abs(-2)) {
		.aboutme-hobby-stack {
			--abs-p: max(calc(var(--k) - var(--p)), calc(var(--p) - var(--k)));
			--abs-v: max(calc(var(--v) - var(--p)), calc(var(--p) - var(--v)));
		}

		.aboutme-hobby-card {
			--abs-top: max(calc(var(--k) - var(--i)), calc(var(--i) - var(--k)));
			--abs-mov: max(var(--val-mov), calc(-1 * var(--val-mov)));
		}
	}

	@supports not (scale: sign(-2)) {
		.aboutme-hobby-stack {
			--dir: clamp(-1, calc((var(--k) - var(--p)) * 100000), 1);
		}
	}

	.aboutme-education-list {
		position: relative;
		display: grid;
		gap: 0.95rem;
		padding-left: 1.65rem;
	}

	.aboutme-education-list::before {
		content: '';
		position: absolute;
		top: 0.35rem;
		bottom: 0.35rem;
		left: 0.28rem;
		width: 1px;
		background: rgba(148, 163, 184, 0.18);
	}

	.aboutme-education-item {
		position: relative;
		display: grid;
		gap: 0.42rem;
		padding: 0.15rem 0;
	}

	.aboutme-education-item::before {
		content: '';
		position: absolute;
		top: 0.35rem;
		left: -1.65rem;
		width: 0.56rem;
		height: 0.56rem;
		border-radius: 999px;
		background: var(--color-primary);
		box-shadow: 0 0 0 4px rgba(0, 208, 132, 0.08);
	}

	.aboutme-education-copy {
		display: grid;
		gap: 0.18rem;
	}

	.aboutme-education-title {
		font-family: var(--font-heading);
		font-size: 0.98rem;
		font-weight: 700;
		line-height: 1.25;
		color: var(--color-heading);
	}

	.aboutme-education-degree {
		font-size: 0.9rem;
		font-style: italic;
		line-height: 1.35;
		color: rgba(226, 232, 240, 0.88);
	}

	.aboutme-education-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3rem 0.55rem;
		padding-top: 0.05rem;
		color: var(--color-text-muted);
	}

	.aboutme-education-location,
	.aboutme-education-dates {
		font-size: 0.82rem;
		line-height: 1.4;
	}

	.aboutme-education-location {
		font-weight: 500;
		color: rgba(241, 245, 249, 0.78);
	}

	.aboutme-education-dates {
		color: rgba(148, 163, 184, 0.92);
