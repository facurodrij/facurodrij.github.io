---
---

<article class="mx-auto max-w-6xl">
	<div class="grid gap-4 lg:grid-cols-12 lg:gap-5">
		<div class="grid gap-4 lg:col-span-4 lg:grid-rows-[minmax(0,1.35fr)_minmax(0,0.9fr)] lg:gap-5">
			<section class="aboutme-panel aboutme-panel-hero">
				<p class="aboutme-panel-label">Formación</p>

				<div class="aboutme-education-list">
					<article class="aboutme-education-item">
						<div class="aboutme-education-copy">
							<h3 class="aboutme-education-title">
								Universidad Nacional de Misiones
							</h3>
							<p class="aboutme-education-degree">
								Licenciatura en Sistemas de Información
							</p>
						</div>

						<div class="aboutme-education-meta">
							<p class="aboutme-education-location">Misiones - Argentina</p>
							<p class="aboutme-education-dates">Feb. 2019 - Jun. 2024</p>
						</div>
					</article>

					<article class="aboutme-education-item">
						<div class="aboutme-education-copy">
							<h3 class="aboutme-education-title">
								Universidad Nacional de Misiones
							</h3>
							<p class="aboutme-education-degree">
								Analista en Sistemas de Computación
							</p>
						</div>

						<div class="aboutme-education-meta">
							<p class="aboutme-education-location">Misiones - Argentina</p>
							<p class="aboutme-education-dates">Feb. 2019 - Mar. 2023</p>
						</div>
					</article>
				</div>
			</section>

			<section class="aboutme-panel aboutme-location-panel">
				<div class="aboutme-location-content">
					<h3 class="aboutme-location-title">Posadas, Argentina</h3>
					<p class="aboutme-location-coordinates">27.3671° S, 55.8961° W</p>
					<p class="aboutme-location-timezone">- UTC-3</p>
				</div>
			</section>
		</div>

		<div class="aboutme-summary-panels lg:col-span-8">
			<section class="aboutme-panel aboutme-summary-panel aboutme-summary-panel-wide">
				<p class="aboutme-panel-label">Hoy me mueve</p>
				<p class="aboutme-summary-copy">
					Aprender, construir y aportar en proyectos con impacto.
				</p>
			</section>

			<section class="aboutme-panel aboutme-summary-panel">
				<p class="aboutme-panel-label">Mentalidad</p>
				<p class="aboutme-summary-copy">Software claro, util y bien resuelto.</p>
			</section>

			<section class="aboutme-panel aboutme-summary-panel">
				<p class="aboutme-panel-label">Enfoque</p>
				<p class="aboutme-summary-copy">
					Vision full stack con criterio tecnico y foco en producto.
				</p>
			</section>
		</div>
	</div>
</article>

<style>
	.aboutme-panel {
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 100%;
		padding: 1.5rem;
		border-radius: clamp(1.25rem, 2vw, 1.75rem);
		border: 1px solid rgba(148, 163, 184, 0.12);
		background:
			radial-gradient(circle at top, rgba(255, 255, 255, 0.05), transparent 38%),
			linear-gradient(180deg, rgba(17, 24, 39, 0.94), rgba(12, 18, 32, 0.92));
		box-shadow:
			0 24px 60px rgba(2, 6, 23, 0.32),
			inset 0 1px 0 rgba(255, 255, 255, 0.05);
	}

	.aboutme-panel::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(135deg, rgba(139, 92, 246, 0.08), transparent 36%);
		opacity: 0.9;
	}

	.aboutme-panel > * {
		position: relative;
		z-index: 1;
	}

	.aboutme-panel-hero {
		justify-content: flex-start;
		gap: 1.35rem;
		min-height: 19rem;
	}

	.aboutme-summary-panels {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.95rem;
	}

	.aboutme-summary-panel {
		justify-content: flex-start;
		gap: 1.25rem;
		min-height: 9.5rem;
	}

	.aboutme-summary-copy {
		max-width: 24ch;
		font-family: var(--font-heading);
		font-size: clamp(1.25rem, 2vw, 1.75rem);
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: -0.03em;
		color: var(--color-heading);
		text-wrap: balance;
	}

	.aboutme-education-list {
		position: relative;
		display: grid;
		gap: 0.95rem;
		padding-left: 1.65rem;
	}

	.aboutme-education-list::before {
		content: '';
		position: absolute;
		top: 0.35rem;
		bottom: 0.35rem;
		left: 0.28rem;
		width: 1px;
		background: rgba(148, 163, 184, 0.18);
	}

	.aboutme-education-item {
		position: relative;
		display: grid;
		gap: 0.42rem;
		padding: 0.15rem 0;
	}

	.aboutme-education-item::before {
		content: '';
		position: absolute;
		top: 0.35rem;
		left: -1.65rem;
		width: 0.56rem;
		height: 0.56rem;
		border-radius: 999px;
		background: var(--color-primary);
		box-shadow: 0 0 0 4px rgba(0, 208, 132, 0.08);
	}

	.aboutme-education-copy {
		display: grid;
		gap: 0.18rem;
	}

	.aboutme-education-title {
		font-family: var(--font-heading);
		font-size: 0.98rem;
		font-weight: 700;
		line-height: 1.25;
		color: var(--color-heading);
	}

	.aboutme-education-degree {
		font-size: 0.9rem;
		font-style: italic;
		line-height: 1.35;
		color: rgba(226, 232, 240, 0.88);
	}

	.aboutme-education-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3rem 0.55rem;
		padding-top: 0.05rem;
		color: var(--color-text-muted);
	}

	.aboutme-education-location,
	.aboutme-education-dates {
		font-size: 0.82rem;
		line-height: 1.4;
	}

	.aboutme-education-location {
		font-weight: 500;
		color: rgba(241, 245, 249, 0.78);
	}

	.aboutme-education-dates {
		color: rgba(148, 163, 184, 0.92);
	}

	.aboutme-location-panel {
		justify-content: flex-end;
		min-height: 11.5rem;
		padding: 1.15rem 1.25rem;
		border-color: rgba(255, 255, 255, 0.08);
		background: linear-gradient(180deg, rgba(7, 11, 18, 0.46), rgba(7, 11, 18, 0.86));
		box-shadow:
			0 22px 48px rgba(2, 6, 23, 0.28),
			inset 0 1px 0 rgba(255, 255, 255, 0.03);
	}

	.aboutme-location-content {
		display: grid;
		gap: 0.14rem;
		max-width: 100%;
	}

	.aboutme-location-title {
		font-family: var(--font-heading);
		font-size: clamp(1.2rem, 2.65vw, 1.95rem);
		font-weight: 900;
		line-height: 0.94;
		letter-spacing: -0.05em;
		color: rgba(248, 250, 252, 0.98);
		white-space: nowrap;
		text-shadow: 0 18px 36px rgba(2, 6, 23, 0.48);
	}

	.aboutme-location-coordinates {
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(226, 232, 240, 0.58);
		text-shadow: 0 10px 24px rgba(2, 6, 23, 0.34);
	}

	.aboutme-location-timezone {
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-primary);
		text-shadow: 0 10px 24px rgba(2, 6, 23, 0.34);
	}

	.aboutme-location-panel::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(8, 10, 18, 0.26), rgba(8, 10, 18, 0.82)),
			radial-gradient(circle at 50% 16%, rgba(255, 255, 255, 0.08), transparent 48%),
			url('/posadas.jpeg') center center / cover no-repeat;
		filter: grayscale(1) contrast(1.02) brightness(0.88);
		transform: scale(1.01);
	}

	.aboutme-location-panel::after {
		background:
			linear-gradient(180deg, rgba(10, 12, 20, 0.06), rgba(10, 12, 20, 0.78)),
			linear-gradient(135deg, rgba(255, 255, 255, 0.04), transparent 42%);
		opacity: 1;
	}

	.aboutme-panel-label {
		font-family: var(--font-heading);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		position: relative;
		display: inline-flex;
		align-items: center;
	}

	.aboutme-panel-label::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: -0.36rem;
		width: 2.2rem;
		height: 2px;
		border-radius: 999px;
		background: var(--color-primary);
	}

	@media (min-width: 768px) {
		.aboutme-panel {
			padding: 1.75rem;
		}

		.aboutme-summary-panels {
			gap: 1.25rem;
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.aboutme-summary-panel {
			min-height: 0;
			gap: 1.25rem;
		}

		.aboutme-summary-panel-wide {
			grid-column: 1 / -1;
		}

		.aboutme-education-item {
			gap: 0.45rem;
		}

		.aboutme-location-panel {
			padding: 1.35rem 1.5rem;
		}

		.aboutme-location-title {
			font-size: clamp(1.45rem, 1.95vw, 2.1rem);
		}
	}

	@media (min-width: 1024px) {
		.aboutme-panel {
			min-height: 18rem;
		}

		.aboutme-summary-panel {
			min-height: 15rem;
		}

		.aboutme-summary-panel-wide {
			min-height: 10.5rem;
		}

		.aboutme-panel-hero {
			min-height: 18rem;
		}

		.aboutme-location-panel {
			min-height: 12rem;
		}
	}
</style>
