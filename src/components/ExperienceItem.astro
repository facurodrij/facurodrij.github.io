---
import LinkInline from './LinkInline.astro';
import TechChips from './TechChips.astro';
import ReadIcon from './icons/Read.astro';

interface Props {
	id?: string;
	title: string;
	company: string;
	description: string;
	highlights?: string[];
	tech?: {
		name: string;
		className: string;
		icon: (props: Record<string, unknown>) => unknown;
	}[];
	link?: string;
	date: string;
	location?: string;
	certification?: string;
	current?: boolean;
}

const {
	id,
	title,
	company,
	description,
	highlights = [],
	tech = [],
	link,
	date,
	location,
	certification,
	current = false,
} = Astro.props;

// Everything but the summary paragraph sits behind "Más info".
const hasMore =
	highlights.length > 0 || tech.length > 0 || Boolean(link || certification);
const moreId = `experience-${(id ?? `${company}-${date}`)
	.toLowerCase()
	.normalize('NFD')
	.replace(/[^a-z0-9]+/g, '-')
	.replace(/^-|-$/g, '')}-more`;
---

<div
	id={id}
	class:list={[
		'ds-experience-item ds-card ds-glass-panel relative ml-4 grid gap-6 px-6 py-6 md:ml-6 md:grid-cols-5 md:gap-8',
		{ 'is-current': current },
	]}
	data-experience-item
	data-revealed="false"
	data-active="false"
>
	<span
		aria-hidden="true"
		class="ds-experience-marker absolute -left-[1.85rem] top-[1.4rem] h-4 w-4 rounded-full bg-[var(--color-primary)] md:-left-[2.35rem]"
	></span>

	<div class="relative md:col-span-2">
		<div>
			<h3
				data-ui-heading="true"
				class="text-xl font-bold text-[var(--color-heading)] md:text-[1.4rem]"
			>
				{title}
			</h3>
			<h4 class="mt-1 text-lg font-semibold text-[var(--color-primary)]">
				{company}
			</h4>
			<time
				class="mt-2 inline-flex rounded-[var(--radius-sm)] bg-[var(--color-primary-soft)] px-3 py-1 text-sm font-medium text-[var(--color-heading)]"
				>{date}</time
			>
			{
				location && (
					<p class="mt-2 text-sm text-[var(--color-text-muted)]">{location}</p>
				)
			}
		</div>
	</div>
	<div class="ds-body relative flex flex-col gap-3 md:col-span-3">
		<p>{description}</p>
		{
			hasMore && (
				<>
					<button
						type="button"
						class="ds-button ds-button-primary mt-1 w-fit"
						aria-expanded="false"
						aria-controls={moreId}
						data-experience-more-toggle
					>
						<ReadIcon class="size-6" />
						<span data-experience-more-label>Más info</span>
						<svg
							class="experience-more__chevron size-4"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<path d="m6 9 6 6 6-6" />
						</svg>
					</button>
					<div id={moreId} class="experience-more" data-experience-more inert>
						<div class="experience-more__clip">
							<div class="experience-more__inner">
								{highlights.length > 0 && (
									<ul class="ds-experience-highlights">
										{highlights.map((highlight) => (
											<li>{highlight}</li>
										))}
									</ul>
								)}
								{tech.length > 0 && (
									<div class="mt-1.5">
										<TechChips tools={tech} label="Tecnologías" expanded />
									</div>
								)}
								{link && (
									<LinkInline
										href={link}
										className="ds-experience-link mt-2 w-fit"
									>
										Saber más{' '}
										<svg
											xmlns="http://www.w3.org/2000/svg"
											class="icon icon-tabler icon-tabler-chevron-right w-5"
											width="24"
											height="24"
											viewBox="0 0 24 24"
											stroke-width="2"
											stroke="currentColor"
											fill="none"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<>
												<path stroke="none" d="M0 0h24v24H0z" fill="none" />
												<path d="M9 6l6 6l-6 6" />
											</>
										</svg>
									</LinkInline>
								)}
								{certification && (
									<LinkInline
										href={certification}
										className="ds-experience-link w-fit"
									>
										Ver certificado{' '}
										<svg
											xmlns="http://www.w3.org/2000/svg"
											class="icon icon-tabler icon-tabler-chevron-right w-5"
											width="24"
											height="24"
											viewBox="0 0 24 24"
											stroke-width="2"
											stroke="currentColor"
											fill="none"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<>
												<path stroke="none" d="M0 0h24v24H0z" fill="none" />
												<path d="M9 6l6 6l-6 6" />
											</>
										</svg>
									</LinkInline>
								)}
							</div>
						</div>
					</div>
				</>
			)
		}
	</div>
</div>

<style>
	.experience-more__chevron {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	[aria-expanded='true'] > .experience-more__chevron {
		transform: rotate(180deg);
	}

	/* Same unfold as the projects' "Más info": rows animate 0fr -> 1fr. */
	.experience-more {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 560ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.ds-experience-item.is-open .experience-more {
		grid-template-rows: 1fr;
	}

	.experience-more__clip {
		min-height: 0;
		overflow: hidden;
	}

	.experience-more__inner {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding-top: 0.5rem;
		opacity: 0;
		transform: translateY(-0.75rem);
		transition:
			opacity 320ms ease,
			transform 480ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.ds-experience-item.is-open .experience-more__inner {
		opacity: 1;
		transform: none;
		transition-delay: 100ms;
	}

	.ds-experience-highlights {
		display: grid;
		gap: 0.45rem;
	}

	.ds-experience-highlights li {
		position: relative;
		padding-left: 1.1rem;
	}

	.ds-experience-highlights li::before {
		content: '';
		position: absolute;
		left: 0.15rem;
		top: 0.62em;
		width: 0.35rem;
		height: 0.35rem;
		border-radius: 999px;
		background: var(--color-primary);
		opacity: 0.8;
	}

	/* Hollow ring by default; filled once passed; the active one glows. The
	   background-colored spread cuts the line around each marker. */
	.ds-experience-marker {
		z-index: 1;
		background: var(--color-bg);
		border: 2px solid rgba(var(--color-primary-rgb), 0.5);
		box-shadow: 0 0 0 4px var(--color-bg);
		transition:
			transform 260ms ease,
			background-color 260ms ease,
			border-color 260ms ease,
			box-shadow 260ms ease;
	}

	.ds-experience-item[data-timeline-state='past'] .ds-experience-marker {
		background: var(--color-primary);
		border-color: var(--color-primary);
		box-shadow:
			0 0 0 4px var(--color-bg),
			0 0 8px rgba(var(--color-primary-rgb), 0.55);
	}

	.ds-experience-item[data-active='true'] .ds-experience-marker,
	.ds-experience-item:hover .ds-experience-marker {
		background: var(--color-primary);
		border-color: var(--color-primary-light);
		transform: scale(1.15);
		box-shadow:
			0 0 0 4px var(--color-bg),
			0 0 10px rgba(var(--color-primary-rgb), 0.85),
			0 0 26px rgba(var(--color-primary-rgb), 0.4);
	}

	:global(.ds-experience-link) {
		position: relative;
		gap: 0.45rem;
		padding-bottom: 0.1rem;
		color: var(--color-secondary);
	}

	:global(.ds-experience-link:hover),
	:global(.ds-experience-link:focus-visible) {
		color: var(--color-secondary) !important;
	}

	:global(.ds-experience-link)::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.12rem;
		height: 1px;
		background: var(--color-secondary);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 180ms ease;
	}

	:global(.ds-experience-link) :global(svg) {
		transition: none;
	}

	:global(.ds-experience-link:hover)::after,
	:global(.ds-experience-link:focus-visible)::after {
		transform: scaleX(1);
	}

	:global(.ds-experience-link:hover) :global(svg),
	:global(.ds-experience-link:focus-visible) :global(svg) {
		transform: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.ds-experience-item[data-active='true'] .ds-experience-marker,
		.ds-experience-item:hover .ds-experience-marker,
		:global(.ds-experience-link:hover) :global(svg),
		:global(.ds-experience-link:focus-visible) :global(svg) {
			transform: none;
		}
	}
</style>

<script>
	// "Más info" toggle for each experience card: shows the highlights, tech
	// chips and links below the summary paragraph. Escape closes it again.
	const setupExperienceMore = () => {
		document
			.querySelectorAll<HTMLButtonElement>(
				'[data-experience-more-toggle]:not([data-ready])',
			)
			.forEach((button) => {
				button.dataset.ready = '';
				const item = button.closest<HTMLElement>('[data-experience-item]');
				const panel = document.getElementById(
					button.getAttribute('aria-controls') ?? '',
				);
				const label = button.querySelector('[data-experience-more-label]');
				if (!item || !panel) return;

				const setOpen = (open: boolean) => {
					item.classList.toggle('is-open', open);
					button.setAttribute('aria-expanded', String(open));
					panel.inert = !open;
					if (label) label.textContent = open ? 'Menos info' : 'Más info';
				};

				button.addEventListener('click', () =>
					setOpen(!item.classList.contains('is-open')),
				);
				item.addEventListener('keydown', (event) => {
					if (event.key !== 'Escape' || !item.classList.contains('is-open')) {
						return;
					}
					setOpen(false);
					button.focus();
				});
			});
	};

	document.addEventListener('astro:page-load', setupExperienceMore);
</script>
