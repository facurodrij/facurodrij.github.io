---
import LinkInline from './LinkInline.astro';

interface Props {
	title: string;
	company: string;
	description: string;
	link?: string;
	date: string;
	certification?: string;
}

const { title, company, description, link, date, certification } = Astro.props;
---

<div
	class="ds-card relative ml-5 grid gap-6 px-6 py-6 before:absolute before:left-[-20px] before:top-7 before:block before:h-[calc(100%+1.25rem)] before:border-l before:border-[var(--color-border)] before:content-[''] md:ml-8 md:grid-cols-5 md:gap-8"
>
	<div class="relative md:col-span-2">
		<div class="sticky top-24">
			<span
				aria-hidden="true"
				class="absolute -left-[2.35rem] top-0.5 h-4 w-4 rounded-full border-4 border-[var(--color-bg)] bg-[var(--color-primary)] shadow-[0_0_0_5px_rgba(0,208,132,0.16)] md:-left-[3rem]"
			></span>

			<h3
				data-ui-heading="true"
				class="text-xl font-bold text-[var(--color-heading)]"
			>
				{title}
			</h3>
			<h4 class="mt-1 text-lg font-semibold text-[var(--color-primary)]">
				{company}
			</h4>
			<time
				class="mt-2 inline-flex rounded-[var(--radius-sm)] bg-[var(--color-primary-soft)] px-3 py-1 text-sm font-medium text-[var(--color-heading)]"
				>{date}</time
			>
		</div>
	</div>
	<div class="ds-body relative flex flex-col gap-3 md:col-span-3">
		{description}
		{
			link && (
				<LinkInline href={link}>
					Saber más{' '}
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="w-5 icon icon-tabler icon-tabler-chevron-right"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						stroke-width="2"
						stroke="currentColor"
						fill="none"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<>
							<path stroke="none" d="M0 0h24v24H0z" fill="none" />
							<path d="M9 6l6 6l-6 6" />
						</>
					</svg>
				</LinkInline>
			)
		}
		{
			certification && (
				<LinkInline href={certification}>
					Ver certificado{' '}
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="w-5 icon icon-tabler icon-tabler-chevron-right"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						stroke-width="2"
						stroke="currentColor"
						fill="none"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<>
							<path stroke="none" d="M0 0h24v24H0z" fill="none" />
							<path d="M9 6l6 6l-6 6" />
						</>
					</svg>
				</LinkInline>
			)
		}
	</div>
</div>
