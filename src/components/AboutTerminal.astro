---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import playaImage from '../assets/aboutme/playa.jpeg';
import viajesImage from '../assets/aboutme/viajes.jpeg';
import asadoImage from '../assets/aboutme/asado.jpeg';
// File icons from Material Icon Theme (MIT, see src/assets/material-icons/LICENSE).
import readmeIcon from '../assets/material-icons/readme.svg?raw';
import jsonIcon from '../assets/material-icons/json.svg?raw';
import yamlIcon from '../assets/material-icons/yaml.svg?raw';
import typescriptIcon from '../assets/material-icons/typescript.svg?raw';
import imageIcon from '../assets/material-icons/image.svg?raw';
import pdfIcon from '../assets/material-icons/pdf.svg?raw';
import folderImagesIcon from '../assets/material-icons/folder-images.svg?raw';
import folderImagesOpenIcon from '../assets/material-icons/folder-images-open.svg?raw';
import consoleIcon from '../assets/material-icons/console.svg?raw';

const square = (src: ImageMetadata) =>
	getImage({ src, width: 420, height: 420, fit: 'cover', format: 'webp' }).then(
		(img) => img.src,
	);

const [playa, viajes, asado] = await Promise.all(
	[playaImage, viajesImage, asadoImage].map(square),
);

const cleanIcon = (svg: string) =>
	svg
		.trim()
		.replace(/\sid="[^"]*"/g, '')
		.replace('<path d="M0 0h24v24H0z"/>', '')
		.replace('<svg ', '<svg aria-hidden="true" focusable="false" ');

const data = {
	images: { playa, viajes, asado },
	icons: {
		readme: cleanIcon(readmeIcon),
		json: cleanIcon(jsonIcon),
		yaml: cleanIcon(yamlIcon),
		typescript: cleanIcon(typescriptIcon),
		image: cleanIcon(imageIcon),
		pdf: cleanIcon(pdfIcon),
		'folder-images': cleanIcon(folderImagesIcon),
		'folder-images-open': cleanIcon(folderImagesOpenIcon),
		console: cleanIcon(consoleIcon),
	},
};
---

<div class="about-term" data-about-term>
	<script
		type="application/json"
		data-about-data
		set:html={JSON.stringify(data)}
	/>
	<div class="win is-waiting" data-win>
		<div class="titlebar">
			<div class="controls" aria-hidden="true">
				<span class="ctl ctl--close"
					><svg viewBox="0 0 10 10"
						><path d="M2.5 2.5l5 5M7.5 2.5l-5 5"></path></svg
					></span
				>
				<span class="ctl ctl--min"
					><svg viewBox="0 0 10 10"><path d="M2 5h6"></path></svg></span
				>
				<span class="ctl ctl--max"
					><svg viewBox="0 0 10 10"
						><path d="M2 8L8 2M5.8 2H8v2.2M4.2 8H2V5.8"></path></svg
					></span
				>
			</div>
			<span class="titlebar__name" data-title>~/sobre-mi — README.md</span>
		</div>

		<div class="win__body">
			<aside
				class="explorer vscroll"
				id="about-explorer"
				data-explorer
				aria-label="Explorador de archivos"
			>
				<div class="explorer__head">
					<p class="explorer__title">EXPLORADOR</p>
					<button
						class="explorer__close"
						type="button"
						aria-label="Cerrar explorador"
						data-explorer-close
					>
						<svg viewBox="0 0 14 14" aria-hidden="true"
							><path d="M3 3l8 8M11 3l-8 8"></path></svg
						>
					</button>
				</div>
				<ul class="tree" data-tree></ul>
			</aside>
			<div class="drawer-scrim" aria-hidden="true" data-explorer-scrim></div>

			<div class="main">
				<div class="tabbar">
					<button
						class="files-toggle"
						type="button"
						aria-controls="about-explorer"
						aria-expanded="false"
						data-files-toggle
					>
						<svg viewBox="0 0 24 24" aria-hidden="true"
							><path d="M4 6h16M4 12h16M4 18h10"></path></svg
						>Archivos
					</button>
					<div
						class="tabs"
						role="tablist"
						aria-label="Archivos abiertos"
						data-tabs
					>
					</div>
				</div>

				<div class="crumbs">
					<span class="crumbs__path" data-crumbs></span>
					<span
						class="viewmode"
						role="group"
						aria-label="Modo de vista"
						data-viewmode
						hidden
					>
						<button type="button" aria-pressed="false" data-mode="code"
							>Código</button
						>
						<button type="button" aria-pressed="true" data-mode="preview"
							>Vista previa</button
						>
					</span>
				</div>

				<div
					class="editor vscroll"
					data-editor
					tabindex="0"
					role="region"
					aria-label="Contenido del archivo"
				>
				</div>

				<section class="panel" aria-label="Terminal">
					<div
						class="sash"
						role="separator"
						aria-orientation="horizontal"
						aria-label="Cambiar el alto de la terminal"
						aria-valuemin="120"
						aria-valuemax="432"
						aria-valuenow="236"
						tabindex="0"
						data-sash
					>
						<span class="sash__grip"></span>
					</div>
					<div class="panel__head">
						<div class="panel__tabs" role="tablist" aria-label="Panel">
							<button
								class="panel__tab"
								type="button"
								role="tab"
								id="about-ptab-problems"
								aria-controls="about-ppanel-problems"
								aria-selected="false"
								tabindex="-1"
								data-ptab="problems">PROBLEMAS<b>0</b></button
							>
							<button
								class="panel__tab"
								type="button"
								role="tab"
								id="about-ptab-terminal"
								aria-controls="about-ppanel-terminal"
								aria-selected="true"
								data-ptab="terminal">TERMINAL</button
							>
						</div>
						<span class="panel__meta"
							><span data-icon="console" class="mi"></span>zsh</span
						>
					</div>
					<div class="term vscroll" data-term>
						<div
							class="term__problems"
							id="about-ppanel-problems"
							role="tabpanel"
							aria-labelledby="about-ptab-problems"
							data-problems
							hidden
						>
							<p class="muted">
								No se detectaron problemas en el área de trabajo.
							</p>
						</div>
						<div
							id="about-ppanel-terminal"
							role="tabpanel"
							aria-labelledby="about-ptab-terminal"
							data-term-out
							aria-live="polite"
						>
							<p class="dim" data-login></p>
							<p class="muted">
								Escribí <span class="ok">help</span> para ver los comandos. <span
									class="dim">Tab autocompleta · ↑ ↓ historial</span
								>
							</p>
						</div>
						<form class="cmdline" data-cmdline autocomplete="off">
							<label class="cmdline__prompt" for="about-cmd" data-prompt
							></label>
							<div class="cmdline__field">
								<div class="cmdline__ghost" aria-hidden="true">
									<span class="typed" data-ghost-typed></span><span
										data-ghost-rest></span>
								</div>
								<input
									id="about-cmd"
									spellcheck="false"
									autocapitalize="off"
									autocomplete="off"
									aria-describedby="about-cmd-hint"
									data-input
								/>
							</div>
						</form>
					</div>
					<div>
						<div class="chips" id="about-cmd-hint">
							Probá:
							<button class="chip" type="button" data-run="neofetch"
								>neofetch</button
							>
							<button class="chip" type="button" data-run="ls -la"
								>ls -la</button
							>
							<button class="chip" type="button" data-run="cat mentalidad.yml"
								>cat mentalidad.yml</button
							>
							<button class="chip" type="button" data-run="code formacion.json"
								>code formacion.json</button
							>
							<button class="chip" type="button" data-run="contacto"
								>contacto</button
							>
						</div>
					</div>
				</section>
			</div>
		</div>

		<footer class="status">
			<div>
				<span class="branch"
					><svg viewBox="0 0 16 16" aria-hidden="true"
						><circle cx="4.5" cy="3.5" r="1.75"></circle><circle
							cx="4.5"
							cy="12.5"
							r="1.75"></circle><circle cx="11.5" cy="4.5" r="1.75"
						></circle><path d="M4.5 5.25v5.5M11.5 6.25c0 3.25-7 2.5-7 4.5"
						></path></svg
					>main</span
				><span>⊘ 0 ⚠ 0</span><span class="wide">Python 3.12 · Node 22</span>
			</div>
			<div>
				<span data-status-ln>Ln 1, Col 1</span><span class="wide"
					>Espacios: 2</span
				><span class="wide">UTF-8</span><span data-status-lang>Markdown</span>
			</div>
		</footer>
	</div>
</div>

<script>
	import '../scripts/about-terminal.js';
</script>

<style is:global>
	/* "Quién soy" as a VS Code-like window. Global (not scoped) because most of the markup is
	   rendered by the script at runtime; every selector is namespaced under .about-term. */
	.about-term {
		--bg: var(--color-bg);
		--glass: rgba(11, 18, 32, 0.72);
		--pane: rgba(6, 11, 22, 0.78);
		--pane-2: rgba(9, 15, 29, 0.86);
		--border: rgba(148, 163, 184, 0.16);
		--border-strong: rgba(148, 163, 184, 0.3);
		--text: var(--color-text);
		--muted: var(--color-text-muted);
		--faint: rgba(148, 163, 184, 0.45);
		--heading: var(--color-heading);
		--primary: var(--color-primary);
		--primary-soft: rgba(0, 208, 132, 0.14);
		--secondary: var(--color-secondary);
		--secondary-soft: rgba(56, 189, 248, 0.12);
		--support: var(--color-support);
		--syn-key: #c084fc;
		--syn-str: #86efac;
		--syn-num: #fbbf24;
		--syn-fn: #fda4af;
		--font-h: var(--font-heading);
		--font-b: var(--font-body);
		--font-m: var(--font-mono);
		--r-md: 12px;
		--r-lg: 20px;
		color: var(--text);
		font-family: var(--font-b);
		font-size: 15px;
		line-height: 1.6;
	}

	.about-term *,
	.about-term *::before,
	.about-term *::after {
		box-sizing: border-box;
	}

	.about-term [hidden] {
		display: none !important;
	}

	.about-term :is(h1, h2, h3, h4) {
		margin: 0;
		font-family: var(--font-h);
		font-weight: 700;
		color: var(--heading);
		text-wrap: balance;
	}

	.about-term p {
		margin: 0;
	}

	.about-term button {
		font: inherit;
		color: inherit;
		cursor: pointer;
	}

	.about-term a {
		color: inherit;
	}

	.about-term :focus-visible {
		outline: 2px solid var(--secondary);
		outline-offset: 2px;
	}

	.about-term svg {
		display: inline;
	}

	/* ---------- Window ---------- */
	.about-term .win {
		position: relative;
		display: grid;
		grid-template-rows: auto minmax(0, 1fr) auto;
		border-radius: var(--r-lg);
		border: 1px solid var(--border);
		background: var(--glass);
		box-shadow:
			0 30px 80px rgba(2, 6, 23, 0.55),
			inset 0 1px 0 rgba(255, 255, 255, 0.05),
			inset 0 -1px 0 rgba(2, 6, 23, 0.22);
		backdrop-filter: blur(24px) saturate(140%);
		-webkit-backdrop-filter: blur(24px) saturate(140%);
		overflow: hidden;
		overflow: clip;
		transition:
			transform 600ms cubic-bezier(0.22, 1, 0.36, 1),
			opacity 600ms ease;
	}

	/* Opening animation: starts from a visible state, so the page reads fine before it plays. */
	.about-term .win.is-waiting {
		transform: translateY(14px) scale(0.985);
		opacity: 0.75;
	}

	.about-term .win::before {
		content: '';
		position: absolute;
		inset: -40% -10% auto;
		height: 70%;
		background: radial-gradient(
			closest-side,
			rgba(0, 208, 132, 0.1),
			transparent
		);
		pointer-events: none;
	}

	.about-term .titlebar {
		position: relative;
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 10px 14px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}

	.about-term .controls {
		display: flex;
		gap: 7px;
	}

	.about-term .ctl {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18);
	}

	.about-term .ctl svg {
		width: 8px;
		height: 8px;
		opacity: 0;
		transform: scale(0.8);
		transition:
			opacity 160ms ease,
			transform 160ms ease;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		fill: none;
	}

	.about-term .controls:hover .ctl svg {
		opacity: 1;
		transform: scale(1);
	}

	.about-term .ctl--close {
		background: #ff5f57;
		color: #6b1010;
	}
	.about-term .ctl--min {
		background: #febc2e;
		color: #8a5300;
	}
	.about-term .ctl--max {
		background: #28c840;
		color: #0a5f17;
	}

	.about-term .titlebar__name {
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		max-width: 60%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-family: var(--font-m);
		font-size: 11px;
		letter-spacing: 0.06em;
		color: rgba(255, 255, 255, 0.45);
		pointer-events: none;
	}

	.about-term .win__body {
		display: grid;
		grid-template-columns: 232px minmax(0, 1fr);
		height: 620px;
		min-height: 0;
	}

	.about-term .win__body {
		position: relative;
	}

	/* Explorer */
	.about-term .explorer {
		min-width: 0;
		overflow-y: auto;
		border-right: 1px solid var(--border);
		background: rgba(5, 10, 20, 0.5);
		font-size: 13px;
	}

	.about-term .explorer__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
	}

	.about-term .explorer__close {
		display: none;
		place-items: center;
		width: 36px;
		height: 36px;
		margin-right: 6px;
		border: 0;
		border-radius: 8px;
		background: transparent;
		color: var(--muted);
	}

	.about-term .explorer__close:hover {
		background: rgba(148, 163, 184, 0.1);
		color: var(--heading);
	}

	.about-term .explorer__close svg {
		width: 14px;
		height: 14px;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
	}

	.about-term .drawer-scrim {
		display: none;
	}

	.about-term .explorer__title {
		padding: 10px 14px 6px;
		font-family: var(--font-b);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: var(--muted);
	}

	.about-term .tree {
		margin: 0;
		padding: 0 0 12px;
		list-style: none;
	}

	.about-term .tree ul {
		position: relative;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Indent guide, as in VS Code. */
	.about-term .tree ul.nested::before {
		content: '';
		position: absolute;
		left: 21px;
		top: 0;
		bottom: 0;
		width: 1px;
		background: rgba(148, 163, 184, 0.14);
	}

	.about-term .node {
		display: flex;
		align-items: center;
		gap: 6px;
		width: 100%;
		min-height: 28px;
		padding: 3px 10px 3px calc(8px + var(--depth, 0) * 14px);
		border: 0;
		border-left: 2px solid transparent;
		background: transparent;
		text-align: left;
		font-family: var(--font-b);
		font-size: 13px;
		color: var(--text);
		white-space: nowrap;
	}

	.about-term .node:hover {
		background: rgba(148, 163, 184, 0.07);
	}

	.about-term .node[aria-current='true'] {
		background: rgba(0, 208, 132, 0.1);
		border-left-color: var(--primary);
		color: var(--heading);
	}

	.about-term .node--root {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.about-term .chev {
		width: 16px;
		height: 16px;
		flex: none;
		fill: none;
		stroke: var(--muted);
		stroke-width: 1.6;
		transition: transform 160ms ease;
	}

	.about-term [aria-expanded='false'] > .chev {
		transform: rotate(-90deg);
	}

	.about-term .spacer {
		width: 16px;
		flex: none;
	}

	.about-term .mi {
		width: 16px;
		height: 16px;
		flex: none;
	}

	.about-term .sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	.about-term .mi svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* Main column */
	.about-term .main {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: auto auto minmax(0, 1fr) var(--panel-h, 236px);
		min-width: 0;
		min-height: 0;
	}

	.about-term .tabbar {
		display: flex;
		align-items: stretch;
		min-height: 38px;
		border-bottom: 1px solid var(--border);
		background: rgba(4, 8, 18, 0.55);
	}

	.about-term .tabs {
		position: relative;
		display: flex;
		flex: 1;
		min-width: 0;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.about-term .tabs::-webkit-scrollbar {
		display: none;
	}

	.about-term .tab {
		position: relative;
		display: flex;
		align-items: center;
		gap: 4px;
		border-right: 1px solid var(--border);
		background: transparent;
		white-space: nowrap;
	}

	.about-term .tab.is-active {
		background: var(--pane);
	}

	.about-term .tab.is-active::before {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		height: 2px;
		background: var(--primary);
	}

	.about-term .tab__open {
		display: flex;
		align-items: center;
		gap: 7px;
		height: 100%;
		padding: 0 4px 0 12px;
		border: 0;
		background: transparent;
		font-family: var(--font-b);
		font-size: 12.5px;
		color: var(--muted);
	}

	.about-term .tab.is-active .tab__open {
		color: var(--heading);
	}

	.about-term .tab__lock {
		display: inline-grid;
		place-items: center;
		color: var(--faint);
	}

	.about-term .tab__lock svg {
		width: 12px;
		height: 12px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.4;
		stroke-linejoin: round;
	}

	.about-term .tab__close {
		display: grid;
		place-items: center;
		width: 22px;
		height: 22px;
		margin-right: 6px;
		border: 0;
		border-radius: 5px;
		background: transparent;
		color: var(--faint);
		opacity: 0;
	}

	.about-term .tab:hover .tab__close,
	.about-term .tab.is-active .tab__close,
	.about-term .tab__close:focus-visible {
		opacity: 1;
	}

	.about-term .tab__close:hover {
		background: rgba(148, 163, 184, 0.14);
		color: var(--heading);
	}

	.about-term .tab__close svg {
		width: 10px;
		height: 10px;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
	}

	.about-term .files-toggle {
		display: none;
		align-items: center;
		gap: 6px;
		padding: 0 12px;
		border: 0;
		border-right: 1px solid var(--border);
		background: transparent;
		font-family: var(--font-b);
		font-size: 12.5px;
		color: var(--text);
	}

	.about-term .files-toggle svg {
		width: 16px;
		height: 16px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
	}

	.about-term .crumbs {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		min-height: 32px;
		padding: 4px 14px;
		background: var(--pane);
		font-size: 12px;
		color: var(--muted);
	}

	.about-term .crumbs__path {
		display: flex;
		align-items: center;
		gap: 6px;
		min-width: 0;
		overflow: hidden;
		white-space: nowrap;
	}

	.about-term .crumbs__path .sep {
		color: var(--faint);
	}

	.about-term .crumbs__path .mi {
		width: 14px;
		height: 14px;
	}

	.about-term .viewmode {
		display: inline-flex;
		padding: 2px;
		border-radius: 8px;
		border: 1px solid var(--border);
		background: rgba(2, 6, 23, 0.5);
	}

	.about-term .viewmode button {
		min-height: 26px;
		padding: 2px 10px;
		border: 0;
		border-radius: 6px;
		background: transparent;
		font-family: var(--font-b);
		font-size: 12px;
		color: var(--muted);
		white-space: nowrap;
	}

	.about-term .viewmode button[aria-pressed='true'] {
		background: var(--primary-soft);
		color: var(--heading);
	}

	.about-term .editor {
		min-height: 0;
		overflow: auto;
		background: var(--pane);
		outline: none;
	}

	.about-term .editor:focus-visible {
		outline: 2px solid var(--secondary);
		outline-offset: -2px;
	}

	.about-term .editor.is-swapping > * {
		animation: at-fadein 220ms ease;
	}

	@keyframes at-fadein {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
	}

	.about-term .code {
		position: relative;
		padding: 10px 0 24px;
		font-family: var(--font-m);
		font-size: 13px;
		line-height: 1.7;
	}

	.about-term .ln {
		display: grid;
		grid-template-columns: 52px minmax(0, 1fr);
		min-height: 22px;
		white-space: pre;
		cursor: text;
	}

	.about-term .ln > span:first-child {
		padding-right: 18px;
		text-align: right;
		color: rgba(148, 163, 184, 0.32);
		user-select: none;
		font-variant-numeric: tabular-nums;
	}

	.about-term .ln > span:last-child {
		position: relative;
	}

	/* Text cursor: only visible while the editor has focus, as in VS Code. */
	.about-term .caret {
		position: absolute;
		top: 1px;
		bottom: 1px;
		width: 2px;
		margin-left: -1px;
		background: var(--heading);
		pointer-events: none;
		opacity: 0;
	}

	.about-term .editor:focus .caret {
		opacity: 1;
		animation: at-caret-blink 1.1s steps(1) infinite;
	}

	@keyframes at-caret-blink {
		50% {
			opacity: 0;
		}
	}

	/* Read-only hint anchored to the cursor. */
	.about-term .ro-tip {
		position: absolute;
		z-index: 4;
		max-width: min(30rem, calc(100% - 24px));
		padding: 4px 9px;
		border: 1px solid var(--secondary);
		border-radius: 3px;
		background: #0b1222;
		box-shadow: 0 6px 18px rgba(2, 6, 23, 0.55);
		font-family: var(--font-b);
		font-size: 12.5px;
		line-height: 1.45;
		color: var(--text);
		white-space: normal;
		pointer-events: none;
		animation: at-fadein 140ms ease;
	}

	.about-term .ro-tip::before,
	.about-term .ro-tip::after {
		content: '';
		position: absolute;
		left: var(--arrow-x, 14px);
		border: 7px solid transparent;
	}

	.about-term .ro-tip::before {
		top: 100%;
		margin-left: -7px;
		border-top-color: var(--secondary);
	}

	.about-term .ro-tip::after {
		top: calc(100% - 1px);
		margin-left: -6px;
		border-width: 6px;
		border-top-color: #0b1222;
	}

	.about-term .ro-tip.is-below::before {
		top: auto;
		bottom: 100%;
		border-top-color: transparent;
		border-bottom-color: var(--secondary);
	}

	.about-term .ro-tip.is-below::after {
		top: auto;
		bottom: calc(100% - 1px);
		border-top-color: transparent;
		border-bottom-color: #0b1222;
	}

	.about-term .ln.is-active {
		background: rgba(148, 163, 184, 0.06);
		box-shadow:
			inset 0 1px 0 rgba(148, 163, 184, 0.08),
			inset 0 -1px 0 rgba(148, 163, 184, 0.08);
	}

	.about-term .ln.is-active > span:first-child {
		color: var(--heading);
	}

	.about-term .s-key {
		color: var(--syn-key);
	}
	.about-term .s-str {
		color: var(--syn-str);
	}
	.about-term .s-prop {
		color: var(--secondary);
	}
	.about-term .s-num {
		color: var(--syn-num);
	}
	.about-term .s-fn {
		color: var(--syn-fn);
	}
	.about-term .s-com {
		color: var(--support);
		font-style: italic;
	}
	.about-term .s-head {
		color: var(--primary);
		font-weight: 700;
	}
	.about-term .s-bold {
		color: var(--heading);
		font-weight: 700;
	}
	.about-term .s-punc {
		color: var(--muted);
	}

	.about-term .s-link {
		color: var(--secondary);
		text-decoration: underline;
		text-decoration-color: rgba(56, 189, 248, 0.4);
		text-underline-offset: 3px;
	}

	.about-term .s-link:hover {
		color: var(--primary);
		text-decoration-color: currentColor;
	}

	/* Markdown preview */
	.about-term .preview {
		display: grid;
		gap: 14px;
		max-width: 44rem;
		padding: 28px clamp(18px, 4vw, 40px) 40px;
		font-size: 15px;
	}

	.about-term .preview h1 {
		font-size: 30px;
		padding-bottom: 10px;
		border-bottom: 1px solid var(--border);
	}

	.about-term .preview h2 {
		margin-top: 8px;
		font-size: 19px;
		color: var(--primary);
	}

	.about-term .preview strong {
		color: var(--heading);
	}

	.about-term .preview ul {
		display: grid;
		gap: 4px;
		margin: 0;
		padding-left: 20px;
	}

	.about-term .preview li::marker {
		color: var(--primary);
	}

	.about-term .preview a {
		color: var(--secondary);
		text-underline-offset: 3px;
	}

	.about-term .preview a:hover {
		color: var(--primary);
	}

	/* Image and PDF viewers */
	.about-term .viewer {
		display: grid;
		justify-items: center;
		align-content: center;
		gap: 12px;
		min-height: 100%;
		padding: 24px;
		background:
			linear-gradient(
					45deg,
					rgba(148, 163, 184, 0.05) 25%,
					transparent 25%,
					transparent 75%,
					rgba(148, 163, 184, 0.05) 75%
				)
				0 0 / 20px 20px,
			linear-gradient(
					45deg,
					rgba(148, 163, 184, 0.05) 25%,
					transparent 25%,
					transparent 75%,
					rgba(148, 163, 184, 0.05) 75%
				)
				10px 10px / 20px 20px;
	}

	.about-term .viewer img {
		width: min(340px, 100%);
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 10px;
		box-shadow: 0 20px 50px rgba(2, 6, 23, 0.6);
	}

	.about-term .viewer p {
		font-family: var(--font-m);
		font-size: 12px;
		color: var(--muted);
	}

	.about-term .pdf {
		display: grid;
		gap: 10px;
		justify-items: center;
		width: min(320px, 100%);
		padding: 26px 22px;
		border-radius: 10px;
		border: 1px solid var(--border);
		background: rgba(2, 6, 23, 0.55);
		text-align: center;
	}

	.about-term .pdf .mi {
		width: 40px;
		height: 40px;
	}

	.about-term .pdf h4 {
		font-size: 16px;
	}

	.about-term .btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 38px;
		padding: 8px 16px;
		border-radius: 10px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: linear-gradient(
			135deg,
			rgba(0, 208, 132, 0.24),
			rgba(0, 208, 132, 0.12)
		);
		font-family: var(--font-h);
		font-size: 14px;
		font-weight: 700;
		color: var(--heading);
		text-decoration: none;
	}

	.about-term .btn:hover {
		background: linear-gradient(
			135deg,
			rgba(0, 208, 132, 0.34),
			rgba(0, 208, 132, 0.18)
		);
	}

	/* Empty editor, modeled on VS Code's watermark. */
	.about-term .empty {
		display: grid;
		align-content: center;
		justify-items: center;
		gap: 22px;
		min-height: 100%;
		padding: 28px 20px;
	}

	.about-term .empty__mark {
		font-family: var(--font-h);
		font-size: clamp(4rem, 12vw, 7.5rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.04em;
		color: transparent;
		-webkit-text-stroke: 1.5px rgba(148, 163, 184, 0.16);
		user-select: none;
	}

	.about-term .empty__list {
		display: grid;
		gap: 2px;
		width: min(100%, 25rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.about-term .empty__item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 16px;
		width: 100%;
		min-height: 34px;
		padding: 5px 10px;
		border: 0;
		border-radius: 6px;
		background: transparent;
		text-align: left;
		font-family: var(--font-b);
		font-size: 13px;
		color: var(--muted);
	}

	.about-term .empty__item:hover,
	.about-term .empty__item:focus-visible {
		background: rgba(148, 163, 184, 0.08);
		color: var(--heading);
	}

	.about-term .keys {
		display: inline-flex;
		gap: 3px;
	}

	.about-term .keys kbd {
		min-width: 20px;
		padding: 1px 6px;
		border-radius: 4px;
		border: 1px solid var(--border-strong);
		border-bottom-width: 2px;
		background: rgba(148, 163, 184, 0.06);
		font-family: var(--font-m);
		font-size: 11px;
		text-align: center;
		color: var(--text);
	}

	.about-term .keys .cmd {
		font-family: var(--font-m);
		font-size: 11.5px;
		color: var(--primary);
	}

	/* Quick open (Ctrl+P), anchored to the top of the editor column. */
	.about-term .qo {
		position: absolute;
		z-index: 8;
		top: 6px;
		left: 0;
		right: 0;
		width: min(560px, calc(100% - 24px));
		margin-inline: auto;
		overflow: hidden;
		border-radius: 8px;
		border: 1px solid var(--border-strong);
		background: #0b1222;
		box-shadow: 0 18px 50px rgba(2, 6, 23, 0.7);
		animation: at-qo-in 120ms ease;
	}

	@keyframes at-qo-in {
		from {
			opacity: 0;
			translate: 0 -4px;
		}
	}

	.about-term .qo__input {
		display: block;
		width: calc(100% - 12px);
		margin: 6px;
		padding: 6px 10px;
		border: 1px solid var(--secondary);
		border-radius: 4px;
		background: rgba(2, 6, 23, 0.7);
		font-family: var(--font-b);
		font-size: 13px;
		color: var(--heading);
		outline: none;
	}

	.about-term .qo__list {
		max-height: 300px;
		margin: 0;
		padding: 0 0 6px;
		overflow-y: auto;
		list-style: none;
	}

	.about-term .qo__opt {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 4px 12px;
		font-size: 13px;
		color: var(--text);
		cursor: pointer;
	}

	.about-term .qo__opt mark {
		background: none;
		color: var(--secondary);
		font-weight: 700;
	}

	.about-term .qo__opt small {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: 12px;
		color: var(--faint);
	}

	.about-term .qo__opt[aria-selected='true'] {
		background: rgba(56, 189, 248, 0.16);
		box-shadow: inset 0 0 0 1px rgba(56, 189, 248, 0.35);
	}

	.about-term .qo__none {
		padding: 6px 12px 10px;
		font-size: 13px;
		color: var(--muted);
	}

	/* Panel (terminal) */
	.about-term .panel {
		position: relative;
		display: grid;
		grid-template-rows: auto minmax(0, 1fr) auto;
		min-height: 0;
		border-top: 1px solid var(--border);
		background: rgba(3, 7, 15, 0.82);
	}

	/* Drag handle between editor and terminal, as in VS Code. */
	.about-term .sash {
		position: absolute;
		left: 0;
		right: 0;
		top: -5px;
		z-index: 3;
		height: 9px;
		cursor: row-resize;
		touch-action: none;
		outline: none;
	}

	.about-term .sash::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: 4px;
		height: 2px;
		background: transparent;
		transition: background-color 150ms ease 120ms;
	}

	.about-term .sash:hover::after,
	.about-term .sash.is-dragging::after,
	.about-term .sash:focus-visible::after {
		background: var(--primary);
		transition-delay: 0ms;
	}

	.about-term .sash__grip {
		position: absolute;
		left: 50%;
		top: 1px;
		width: 36px;
		height: 7px;
		margin-left: -18px;
		border-radius: 999px;
		border: 1px solid var(--border-strong);
		background: rgba(9, 15, 29, 0.95);
		opacity: 0;
		transition: opacity 150ms ease;
	}

	.about-term .sash:hover .sash__grip,
	.about-term .sash:focus-visible .sash__grip,
	.about-term .sash.is-dragging .sash__grip {
		opacity: 1;
	}

	body.is-resizing {
		cursor: row-resize;
		user-select: none;
	}

	.about-term .panel__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		padding: 0 12px;
		border-bottom: 1px solid rgba(148, 163, 184, 0.08);
	}

	.about-term .panel__tabs {
		display: flex;
		gap: 4px;
	}

	.about-term .panel__tab {
		min-height: 34px;
		padding: 0 8px;
		border: 0;
		border-bottom: 1px solid transparent;
		background: transparent;
		font-family: var(--font-b);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		color: var(--faint);
	}

	.about-term .panel__tab[aria-selected='true'] {
		color: var(--heading);
		border-bottom-color: var(--primary);
	}

	.about-term .panel__tab b {
		display: inline-grid;
		place-items: center;
		min-width: 16px;
		height: 16px;
		margin-left: 4px;
		padding: 0 4px;
		border-radius: 8px;
		background: rgba(148, 163, 184, 0.16);
		font-size: 10px;
	}

	.about-term .panel__meta {
		display: flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-m);
		font-size: 11px;
		color: var(--faint);
	}

	.about-term .panel__meta .mi {
		width: 14px;
		height: 14px;
	}

	.about-term .term {
		min-height: 0;
		overflow-y: auto;
		padding: 8px 14px 4px;
		font-family: var(--font-m);
		font-size: 12.5px;
		line-height: 1.6;
		cursor: text;
	}

	.about-term .term p,
	.about-term .term pre {
		margin: 0;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		font: inherit;
	}

	.about-term .term .dim {
		color: var(--faint);
	}

	.about-term .term .muted {
		color: var(--muted);
	}

	.about-term .term .ok {
		color: var(--primary);
	}

	.about-term .term .err {
		color: #fda4af;
	}

	.about-term .term .acc {
		color: var(--secondary);
	}

	.about-term .term .hl {
		color: var(--heading);
		font-weight: 700;
	}

	.about-term .term a {
		color: var(--secondary);
		text-underline-offset: 3px;
	}

	.about-term .term a:hover {
		color: var(--primary);
	}

	.about-term .prompt-user {
		color: var(--primary);
	}

	.about-term .prompt-path {
		color: var(--secondary);
	}

	.about-term .prompt-arrow {
		color: var(--heading);
	}

	.about-term .neofetch {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 28px;
		padding-block: 4px;
	}

	.about-term .neofetch pre {
		color: var(--primary);
		line-height: 1.25;
	}

	.about-term .neofetch .info {
		display: grid;
		align-content: start;
	}

	.about-term .swatches {
		display: flex;
		gap: 0;
		margin-top: 6px;
	}

	.about-term .swatches i {
		width: 22px;
		height: 12px;
		background: var(--c);
	}

	.about-term .help {
		display: grid;
		grid-template-columns: max-content minmax(0, 1fr);
		gap: 0 18px;
	}

	.about-term .help span:nth-child(odd) {
		color: var(--primary);
	}

	.about-term .help span:nth-child(even) {
		color: var(--muted);
	}

	.about-term .cmdline {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 0 0 8px;
		font-family: var(--font-m);
		font-size: 12.5px;
	}

	.about-term .cmdline__prompt {
		white-space: nowrap;
	}

	.about-term .cmdline__field {
		position: relative;
		flex: 1;
		min-width: 0;
	}

	.about-term .cmdline__ghost,
	.about-term .cmdline input {
		width: 100%;
		min-height: 26px;
		padding: 0;
		border: 0;
		font: inherit;
		letter-spacing: normal;
	}

	.about-term .cmdline__ghost {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		white-space: pre;
		overflow: hidden;
		color: var(--faint);
		pointer-events: none;
	}

	.about-term .cmdline__ghost .typed {
		visibility: hidden;
	}

	.about-term .cmdline input {
		position: relative;
		background: transparent;
		color: var(--heading);
		caret-color: var(--primary);
	}

	.about-term .cmdline input:focus {
		outline: none;
	}

	.about-term .chips {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px;
		padding: 8px 14px 10px;
		font-family: var(--font-m);
		font-size: 11.5px;
		color: var(--faint);
	}

	.about-term .chip {
		min-height: 28px;
		padding: 2px 10px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: transparent;
		font-family: var(--font-m);
		font-size: 11.5px;
		color: var(--muted);
	}

	.about-term .chip:hover {
		color: var(--primary);
		border-color: rgba(0, 208, 132, 0.45);
	}

	/* Status bar */
	.about-term .status {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 2px 14px;
		padding: 4px 12px;
		border-top: 1px solid rgba(0, 208, 132, 0.28);
		background: linear-gradient(
			90deg,
			rgba(0, 208, 132, 0.18),
			rgba(0, 208, 132, 0.08)
		);
		font-family: var(--font-b);
		font-size: 11.5px;
		color: var(--text);
	}

	.about-term .status div {
		display: flex;
		flex-wrap: wrap;
		gap: 2px 14px;
	}

	.about-term .status span {
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}

	.about-term .branch {
		display: inline-flex;
		align-items: center;
		gap: 5px;
	}

	.about-term .branch svg {
		width: 14px;
		height: 14px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.3;
		stroke-linecap: round;
	}

	/* ---------- Scrollbars, VS Code style ----------
	   Thin square slider with no arrows or track, shown only while the pointer is over the
	   scrollable area. Chromium/Safari use ::-webkit-scrollbar (setting the standard
	   scrollbar-color there would override it and bring the arrows back); Firefox gets the
	   standard properties instead. */
	.about-term .vscroll::-webkit-scrollbar {
		width: 10px;
		height: 10px;
	}

	.about-term .vscroll::-webkit-scrollbar-track,
	.about-term .vscroll::-webkit-scrollbar-corner {
		background: transparent;
	}

	.about-term .vscroll::-webkit-scrollbar-button {
		display: none;
	}

	.about-term .vscroll::-webkit-scrollbar-thumb {
		background: transparent;
		border-radius: 0;
	}

	.about-term .vscroll:hover::-webkit-scrollbar-thumb,
	.about-term .vscroll:focus-within::-webkit-scrollbar-thumb {
		background: rgba(148, 163, 184, 0.22);
	}

	.about-term .vscroll::-webkit-scrollbar-thumb:hover {
		background: rgba(148, 163, 184, 0.38);
	}

	.about-term .vscroll::-webkit-scrollbar-thumb:active {
		background: rgba(148, 163, 184, 0.5);
	}

	@supports not selector(::-webkit-scrollbar) {
		.about-term .vscroll {
			scrollbar-width: thin;
