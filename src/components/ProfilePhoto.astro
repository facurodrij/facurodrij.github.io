---
interface Props {
	class?: string;
	frameClass?: string;
}

const { class: className = '', frameClass = 'max-w-[20rem]' } = Astro.props;
---

<div class={`group flex justify-center md:justify-end md:self-start ${className}`.trim()} data-profile-photo-card>
	<div class={`relative w-full ${frameClass}`.trim()}>
		<div
			class="pointer-events-none absolute -left-2 -top-2 h-10 w-10 border-l-2 border-t-2 border-[var(--color-primary)]/80"
		>
		</div>
		<div
			class="pointer-events-none absolute -bottom-2 -right-2 h-10 w-10 border-b-2 border-r-2 border-[var(--color-primary)]/80"
		>
		</div>
		<div class="ds-card-glass relative overflow-hidden rounded-[var(--radius-lg)] p-3 sm:p-4">
			<div class="relative overflow-hidden rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-bg-elevated)]">
				<img
					data-profile-photo-image
					class="aspect-[4/5] w-full object-cover object-top transition duration-500 ease-out [filter:saturate(0.58)_contrast(1.12)_brightness(0.74)] group-hover:scale-[1.01] group-hover:[filter:saturate(1)_contrast(1)_brightness(1)]"
					src="/me.webp"
					alt="Foto de Facundo Joel Rodriguez"
				/>
				<div
					data-profile-photo-overlay
					class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(2,6,23,0.1),rgba(2,6,23,0.28))] opacity-100 transition duration-500 ease-out group-hover:opacity-0"
				>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	[data-profile-photo-card].is-touch-active [data-profile-photo-image] {
		transform: scale(1.01);
		filter: saturate(1) contrast(1) brightness(1);
	}

	[data-profile-photo-card].is-touch-active [data-profile-photo-overlay] {
		opacity: 0;
	}

	@media (hover: none) {
		[data-profile-photo-card]:active [data-profile-photo-image] {
			transform: scale(1.01);
			filter: saturate(1) contrast(1) brightness(1);
		}

		[data-profile-photo-card]:active [data-profile-photo-overlay] {
			opacity: 0;
		}
	}
</style>

<script is:inline>
	(() => {
		const setupProfilePhotoTouchState = () => {
			window.__profilePhotoTouchCleanup?.();

			const cards = Array.from(document.querySelectorAll('[data-profile-photo-card]'));

			if (!cards.length) {
				window.__profilePhotoTouchCleanup = undefined;
				return;
			}

			const supportsTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0;

			if (!supportsTouch) {
				window.__profilePhotoTouchCleanup = undefined;
				return;
			}

			const cleanups = cards.map((card) => {
				let touchTimer;

				const activate = () => {
					card.classList.add('is-touch-active');
					window.clearTimeout(touchTimer);
					touchTimer = window.setTimeout(() => {
						card.classList.remove('is-touch-active');
					}, 850);
				};

				const onTouchStart = () => activate();
				const onTouchEnd = () => activate();
				const onClick = () => activate();
				const onTouchCancel = () => {
					window.clearTimeout(touchTimer);
					card.classList.remove('is-touch-active');
				};

				card.addEventListener('touchstart', onTouchStart, { passive: true });
				card.addEventListener('touchend', onTouchEnd, { passive: true });
				card.addEventListener('click', onClick);
				card.addEventListener('touchcancel', onTouchCancel, { passive: true });

				return () => {
					window.clearTimeout(touchTimer);
					card.classList.remove('is-touch-active');
					card.removeEventListener('touchstart', onTouchStart);
					card.removeEventListener('touchend', onTouchEnd);
					card.removeEventListener('click', onClick);
					card.removeEventListener('touchcancel', onTouchCancel);
				};
			});

			window.__profilePhotoTouchCleanup = () => {
				cleanups.forEach((cleanup) => cleanup());
			};
		};

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', setupProfilePhotoTouchState, { once: true });
		} else {
			setupProfilePhotoTouchState();
		}

		document.addEventListener('astro:page-load', setupProfilePhotoTouchState);
	})();
</script>
