---
import GithubIcon from './icons/Github.astro';
import LinkedInIcon from './icons/LinkedIn.astro';

const footerYear = 2026;
---

<footer class="footer-band mt-20" role="contentinfo">
	<div class="footer-band__inner">
		<p class="footer-band__copy">
			<span class="footer-band__monogram">FJR</span>
			<span class="footer-band__divider" aria-hidden="true">•</span>
			<span>© {footerYear} Facundo Joel Rodriguez.</span>
		</p>

		<p class="footer-band__license">
			Hecho con
			<span class="footer-band__heart" aria-hidden="true">❤</span>
			usando Astro & Tailwind.
		</p>

		<div class="footer-band__links" aria-label="Enlaces de contacto">
			<a
				href="https://github.com/facurodrij"
				target="_blank"
				rel="noopener noreferrer"
				class="footer-band__icon-link"
				aria-label="GitHub"
			>
				<GithubIcon class="size-4" />
			</a>
			<a
				href="https://www.linkedin.com/in/facundo-joel-rodriguez/"
				target="_blank"
				rel="noopener noreferrer"
				class="footer-band__icon-link"
				aria-label="LinkedIn"
			>
				<LinkedInIcon class="size-4" />
			</a>
			<a
				id="contacto"
				href="mailto:facurodri00@gmail.com"
				class="footer-band__icon-link"
				aria-label="Contacto por email"
			>
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.85"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="size-4"
					aria-hidden="true"
				>
					<rect x="3" y="5" width="18" height="14" rx="2"></rect>
					<path d="m4 7 8 6 8-6"></path>
				</svg>
			</a>
		</div>
	</div>
</footer>

<style>
	.footer-band {
		position: relative;
		width: 100%;
		border-top: 0.5px solid rgba(148, 163, 184, 0.08);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.015),
			0 -20px 42px rgba(2, 6, 23, 0.32);
		background-color: #040b1c;
	}

	.footer-band__inner {
		position: relative;
		z-index: 1;
		width: min(72rem, 100%);
		margin-inline: auto;
		padding: 1.2rem 1rem;
		display: grid;
		gap: 0.85rem;
		align-items: center;
	}

	.footer-band__copy,
	.footer-band__license {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	.footer-band__copy {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
	}

	.footer-band__monogram {
		font-family: var(--font-heading);
		font-size: 0.98rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		color: var(--color-heading);
	}

	.footer-band__divider {
		color: rgba(148, 163, 184, 0.6);
	}

	.footer-band__license {
		text-align: center;
	}

	.footer-band__heart {
		display: inline-block;
		margin-inline: 0.28rem;
		color: #ef4444;
		transform-origin: center;
		animation: footer-heartbeat 1500ms ease-in-out infinite;
	}

	@keyframes footer-heartbeat {
		0%,
		100% {
			transform: translateY(1px) scale(1);
			color: #7f1d1d;
		}

		50% {
			transform: translateY(1px) scale(1.14);
			color: #ef4444;
		}
	}

	.footer-band__links {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.65rem;
	}

	.footer-band__icon-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 999px;
		border: 1px solid rgba(148, 163, 184, 0.2);
		background: rgba(2, 6, 23, 0.82);
		color: var(--color-text);
	}

	.footer-band__icon-link:hover,
	.footer-band__icon-link:focus-visible {
		border-color: rgba(56, 189, 248, 0.46);
		background: rgba(56, 189, 248, 0.14);
		color: var(--color-heading);
		outline: none;
		transform: translateY(-1px);
	}

	@media (min-width: 860px) {
		.footer-band__inner {
			min-height: 6rem;
			grid-template-columns: 1fr auto 1fr;
			padding-block: 1.35rem;
		}

		.footer-band__copy {
			justify-content: flex-start;
		}

		.footer-band__links {
			justify-content: flex-end;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-band__heart {
			animation: none;
			color: #ef4444;
		}
	}
</style>
