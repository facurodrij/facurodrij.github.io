---
const footerYear = 2026;
---

<footer class="footer-band mt-20" role="contentinfo">
	<div class="footer-band__inner">
		<p class="footer-band__copy">
			<span class="footer-band__monogram">FJR</span>
			<span class="footer-band__divider" aria-hidden="true">•</span>
			<span>© {footerYear} Facundo Joel Rodriguez.</span>
		</p>

		<p class="footer-band__license">
			<a
				href="https://github.com/facurodrij/facurodrij.github.io"
				target="_blank"
				rel="noopener noreferrer"
				class="footer-band__source-link">Ver el código de este sitio</a
			>
		</p>
	</div>
</footer>

<style>
	.footer-band {
		position: relative;
		width: 100%;
		border-top: 0.5px solid rgba(148, 163, 184, 0.08);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.015),
			0 -20px 42px rgba(2, 6, 23, 0.32);
		background-color: #040b1c;
	}

	.footer-band__inner {
		position: relative;
		z-index: 1;
		width: min(72rem, 100%);
		margin-inline: auto;
		padding: 1.2rem 1rem;
		display: grid;
		gap: 0.85rem;
		align-items: center;
	}

	.footer-band__copy,
	.footer-band__license {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	.footer-band__copy {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
	}

	.footer-band__monogram {
		font-family: var(--font-heading);
		font-size: 0.98rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		color: var(--color-heading);
	}

	.footer-band__divider {
		color: rgba(148, 163, 184, 0.6);
	}

	.footer-band__license {
		text-align: center;
	}

	.footer-band__source-link {
		text-decoration: underline;
		text-decoration-color: rgba(148, 163, 184, 0.3);
		text-underline-offset: 3px;
	}

	.footer-band__source-link:hover,
	.footer-band__source-link:focus-visible {
		color: var(--color-heading);
		text-decoration-color: currentColor;
	}

	@media (min-width: 860px) {
		.footer-band__inner {
			min-height: 6rem;
			grid-template-columns: 1fr auto;
			padding-block: 1.35rem;
		}

		.footer-band__copy {
			justify-content: flex-start;
		}

		.footer-band__license {
			text-align: right;
		}
	}
</style>
