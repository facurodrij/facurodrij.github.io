---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
	{
		title: 'Experiencia',
		label: 'experiencia',
		url: '/#experiencia',
	},
	{
		title: 'Proyectos',
		label: 'proyectos',
		url: '/#proyectos',
	},
	{
		title: 'Sobre mí',
		label: 'sobre-mi',
		url: '/#sobre-mi',
	},
	{
		title: 'Contacto',
		label: 'contacto',
		url: 'mailto:facurodri00@gmail.com',
	},
];
---

<header class="fixed top-0 z-20 flex w-full justify-center px-4 pt-4">
	<nav
		id="header-nav"
		class="flex items-center justify-center rounded-full border px-2 py-2 text-sm font-medium"
	>
		{
			navItems.map((link) => (
				<a class="header-link" aria-label={link.label} href={link.url}>
					{link.title}
				</a>
			))
		}
		<ThemeToggle />
	</nav>
</header>

<style>
	#header-nav {
		background: color-mix(
			in srgb,
			var(--color-surface-strong) 86%,
			transparent
		);
		border-color: var(--color-border);
		box-shadow: var(--shadow-soft);
		backdrop-filter: blur(18px);
		animation: nav-shadow 1s linear both;
		animation-timeline: scroll();
		animation-range: 0 100px;
	}

	.header-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		padding: 0.6rem 0.85rem;
		font-family: var(--font-heading);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--color-text-muted);
	}

	.header-link:hover,
	.header-link:focus-visible {
		background: rgba(56, 189, 248, 0.12);
		color: var(--color-heading);
		outline: none;
	}

	@keyframes nav-shadow {
		0% {
			background-color: transparent;
			box-shadow: none;
			backdrop-filter: blur(0);
		}

		to {
			background: color-mix(
				in srgb,
				var(--color-surface-strong) 90%,
				transparent
			);
			box-shadow: var(--shadow-soft);
			backdrop-filter: blur(18px);
		}
	}
</style>
