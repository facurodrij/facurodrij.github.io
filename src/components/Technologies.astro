---
import ReactIcon from './icons/React.astro';
import NextjsIcon from './icons/Nextjs.astro';
import TypeScriptIcon from './icons/TypeScript.astro';
import JavaScriptIcon from './icons/JavaScript.astro';
import NodejsIcon from './icons/Nodejs.astro';
import ExpressIcon from './icons/Express.astro';
import JqueryIcon from './icons/Jquery.astro';
import DjangoIcon from './icons/Django.astro';
import FlaskIcon from './icons/Flask.astro';
import PythonIcon from './icons/Python.astro';
import DotNetIcon from './icons/DotNet.astro';
import MaterialUiIcon from './icons/MaterialUi.astro';
import TailwindIcon from './icons/Tailwind.astro';
import BootstrapIcon from './icons/Bootstrap.astro';
import MongoDBIcon from './icons/MongoDB.astro';
import PostgreSQLIcon from './icons/PostgreSQL.astro';
import SQLiteIcon from './icons/SQLite.astro';
import DockerIcon from './icons/Docker.astro';
import GcpIcon from './icons/Gcp.astro';
import RailwayIcon from './icons/Railway.astro';
import GithubActionsIcon from './icons/GithubActions.astro';

const TECHNOLOGY_GROUPS = [
	{
		title: 'Lenguajes & Frameworks',
		items: [
			{
				name: 'React',
				icon: ReactIcon,
				badgeClassName: 'bg-[#07131c] text-[#61DAFB]',
			},
			{
				name: 'Next.js',
				icon: NextjsIcon,
				badgeClassName: 'bg-white text-black',
			},
			{
				name: 'TypeScript',
				icon: TypeScriptIcon,
				badgeClassName: 'bg-[#3178C6] text-white',
			},
			{
				name: 'JavaScript',
				icon: JavaScriptIcon,
				badgeClassName: 'bg-[#F7DF1E] text-[#111827]',
			},
			{
				name: 'Node.js',
				icon: NodejsIcon,
				badgeClassName: 'bg-[#101a0c] text-[#83CD29]',
			},
			{
				name: 'Express',
				icon: ExpressIcon,
				badgeClassName: 'bg-white text-black',
			},
			{
				name: 'jQuery',
				icon: JqueryIcon,
				badgeClassName: 'bg-white text-[#0868AC]',
			},
			{
				name: 'Django',
				icon: DjangoIcon,
				badgeClassName: 'bg-[#092E20] text-white',
			},
			{
				name: 'Flask',
				icon: FlaskIcon,
				badgeClassName: 'bg-white text-[#010101]',
			},
			{
				name: 'Python',
				icon: PythonIcon,
				badgeClassName: 'bg-[#0f172a] text-white',
			},
			{
				name: '.NET',
				icon: DotNetIcon,
				badgeClassName: 'bg-[#512BD4] text-white',
			},
		],
	},
	{
		title: 'UI & Animation Libraries',
		items: [
			{
				name: 'Material UI',
				icon: MaterialUiIcon,
				badgeClassName: 'bg-[#08131d] text-[#1FA6CA]',
			},
			{
				name: 'Tailwind CSS',
				icon: TailwindIcon,
				badgeClassName: 'bg-[#041c29] text-[#06B6D4]',
			},
			{
				name: 'Bootstrap',
				icon: BootstrapIcon,
				badgeClassName: 'bg-[#7952B3] text-white',
			},
		],
	},
	{
		title: 'Bases de Datos',
		items: [
			{
				name: 'MongoDB',
				icon: MongoDBIcon,
				badgeClassName: 'bg-[#0b2218] text-white',
			},
			{
				name: 'PostgreSQL',
				icon: PostgreSQLIcon,
				badgeClassName: 'bg-[#10273d] text-white',
			},
			{
				name: 'SQLite',
				icon: SQLiteIcon,
				badgeClassName: 'bg-[#e6f4fb] text-[#0f7fcc]',
			},
		],
	},
	{
		title: 'Cloud & DevOps',
		items: [
			{
				name: 'Docker',
				icon: DockerIcon,
				badgeClassName: 'bg-[#031f33] text-[#2496ED]',
			},
			{
				name: 'GCP',
				icon: GcpIcon,
				badgeClassName: 'bg-white text-[#4285F4]',
			},
			{
				name: 'Railway',
				icon: RailwayIcon,
				badgeClassName: 'bg-[#0b1020] text-white',
			},
			{
				name: 'GitHub Actions',
				icon: GithubActionsIcon,
				badgeClassName: 'bg-[#06172f] text-[#2088FF]',
			},
		],
	},
];
---

<section class="space-y-8">
	<div class="mx-auto max-w-3xl text-center">
		<p class="ds-body mx-auto max-w-2xl">
			Stack con el que diseño, construyo y despliego.
		</p>
	</div>

	<div class="grid gap-5">
		{
			TECHNOLOGY_GROUPS.map(({ title, items }) => (
				<article class="tech-category ds-card ds-card-glass rounded-[var(--radius-lg)] p-5 sm:p-6">
					<div class="flex items-center gap-3">
						<h3
							data-ui-heading="true"
							class="text-xl font-bold text-[var(--color-heading)]"
						>
							{title}
						</h3>
					</div>

					<ul class="mt-5 flex flex-wrap gap-2.5">
						{items.map(({ name, icon: Icon, badgeClassName }) => (
							<li>
								<span class="tech-chip">
									<span class:list={['tech-chip__icon', badgeClassName]}>
										<Icon class="size-4 shrink-0" />
									</span>
									<span>{name}</span>
								</span>
							</li>
						))}
					</ul>
				</article>
			))
		}
	</div>
</section>

<style>
	.tech-category {
		border-color: rgba(255, 255, 255, 0.08);
	}

	.tech-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.45rem 0.85rem 0.45rem 0.5rem;
		border-radius: 999px;
		border: 1px solid rgba(148, 163, 184, 0.16);
		background: rgba(2, 6, 23, 0.58);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
		font-size: 0.92rem;
		font-weight: 500;
		color: var(--color-text);
	}

	.tech-chip__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 999px;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.14),
			0 10px 24px rgba(2, 6, 23, 0.18);
	}
</style>
