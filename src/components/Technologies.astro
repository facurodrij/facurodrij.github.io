	{
		title: 'Herramientas & Plataformas',
		items: [
			{
				name: 'Cursor',
				icon: CursorIcon,
				badgeClassName: 'bg-transparent text-white shadow-none',
			},
			{
				name: 'Jira',
				icon: JiraIcon,
				badgeClassName: 'bg-[#071426] text-[#2684FF]',
			},
			{
				name: 'Notion',
				icon: NotionIcon,
				badgeClassName: 'bg-white text-black',
			},
			{
				name: 'OpenCode',
				icon: OpencodeIcon,
				badgeClassName: 'bg-transparent text-[#4B4646] shadow-none',
			},
			{
				name: 'Linux',
				icon: LinuxIcon,
				badgeClassName: 'bg-[#111827] text-white',
			},
		],
	},
];
---

<section class="space-y-8">
	<div class="grid gap-5">
		{
			TECHNOLOGY_GROUPS.map(({ title, items }) => (
				<article class="tech-category ds-card ds-glass-panel rounded-[var(--radius-lg)] p-5 sm:p-6">
					<div class="flex items-center gap-3">
						<h3
							data-ui-heading="true"
							class="text-xl font-bold text-[var(--color-heading)]"
						>
							{title}
						</h3>
					</div>

					<ul class="mt-5 flex flex-wrap gap-2.5">
						{items.map(({ name, icon: Icon, badgeClassName, iconProps }) => (
							<li>
								<span class="tech-chip">
									<span class:list={['tech-chip__icon', badgeClassName]}>
										<Icon class="size-4 shrink-0" {...iconProps} />
									</span>
									<span>{name}</span>
								</span>
							</li>
						))}
					</ul>
				</article>
			))
		}
	</div>
</section>

<style>
	.tech-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.45rem 0.85rem 0.45rem 0.5rem;
		border-radius: 999px;
		border: 1px solid rgba(148, 163, 184, 0.16);
		background: rgba(2, 6, 23, 0.58);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
		font-size: 0.92rem;
		font-weight: 500;
		color: var(--color-text);
	}

	.tech-chip__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 999px;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.14),
			0 10px 24px rgba(2, 6, 23, 0.18);
	}
</style>
