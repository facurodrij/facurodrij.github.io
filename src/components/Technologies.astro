---
import ReactIcon from './icons/React.astro';
import NextjsIcon from './icons/Nextjs.astro';
import TypeScriptIcon from './icons/TypeScript.astro';
import JavaScriptIcon from './icons/JavaScript.astro';
import TerraformIcon from './icons/Terraform.astro';
import NodejsIcon from './icons/Nodejs.astro';
import ExpressIcon from './icons/Express.astro';
import DjangoIcon from './icons/Django.astro';
import FlaskIcon from './icons/Flask.astro';
import PythonIcon from './icons/Python.astro';
import MongoDBIcon from './icons/MongoDB.astro';
import PostgreSQLIcon from './icons/PostgreSQL.astro';
import SQLiteIcon from './icons/SQLite.astro';
import FirebaseIcon from './icons/Firebase.astro';
import RedisIcon from './icons/Redis.astro';
import DockerIcon from './icons/Docker.astro';
import AwsIcon from './icons/Aws.astro';
import GcpIcon from './icons/Gcp.astro';
import RailwayIcon from './icons/Railway.astro';
import GithubActionsIcon from './icons/GithubActions.astro';
import JiraIcon from './icons/Jira.astro';
import NotionIcon from './icons/Notion.astro';
import CursorIcon from './icons/Cursor.astro';
import OpencodeIcon from './icons/Opencode.astro';
import LinuxIcon from './icons/Linux.astro';
import PatternIcon from './icons/Pattern.astro';

interface TechItem {
	name: string;
	icon: (props: Record<string, unknown>) => unknown;
	badgeClassName: string;
	iconProps?: Record<string, string>;
}

const CONCEPT_PURPLE = 'bg-[#170a33] text-[var(--color-primary)]';
const CONCEPT_BLUE = 'bg-[#071c2b] text-[#38bdf8]';

const TECHNOLOGY_GROUPS: { title: string; items: TechItem[] }[] = [
	{
		title: 'Lenguajes & Frameworks',
		items: [
			{
				name: 'JavaScript',
				icon: JavaScriptIcon,
				badgeClassName: 'bg-[#F7DF1E] text-[#111827]',
			},
			{
				name: 'TypeScript',
				icon: TypeScriptIcon,
				badgeClassName: 'bg-[#3178C6] text-white',
			},
			{
				name: 'React',
				icon: ReactIcon,
				badgeClassName: 'bg-[#07131c] text-[#61DAFB]',
			},
			{
				name: 'Next.js',
				icon: NextjsIcon,
				badgeClassName: 'bg-white text-black',
			},
			{
				name: 'Node.js',
				icon: NodejsIcon,
				badgeClassName: 'bg-[#101a0c] text-[#83CD29]',
			},
			{
				name: 'Express',
				icon: ExpressIcon,
				badgeClassName: 'bg-white text-black',
			},
			{
				name: 'Python',
				icon: PythonIcon,
				badgeClassName: 'bg-[#0f172a] text-white',
			},
			{
				name: 'Flask',
				icon: FlaskIcon,
				badgeClassName: 'bg-white text-[#010101]',
			},
			{
				name: 'Django',
				icon: DjangoIcon,
				badgeClassName: 'bg-[#092E20] text-white',
			},
		],
	},
	{
		title: 'Bases de Datos',
		items: [
			{
				name: 'Firebase',
				icon: FirebaseIcon,
				badgeClassName: 'bg-[#fff7ed] text-[#f58220]',
			},
			{
				name: 'MongoDB',
				icon: MongoDBIcon,
				badgeClassName: 'bg-[#0b2218] text-white',
			},
			{
				name: 'PostgreSQL',
				icon: PostgreSQLIcon,
				badgeClassName: 'bg-[#10273d] text-white',
			},
			{
				name: 'Redis',
				icon: RedisIcon,
				badgeClassName: 'bg-[#2f1108] text-[#D82C20]',
			},
			{
				name: 'SQLite',
				icon: SQLiteIcon,
				badgeClassName: 'bg-[#e6f4fb] text-[#0f7fcc]',
			},
		],
	},
	{
		title: 'Cloud & DevOps',
		items: [
			{
				name: 'Docker',
				icon: DockerIcon,
				badgeClassName: 'bg-[#031f33] text-[#2496ED]',
			},
			{
				name: 'GitHub Actions',
				icon: GithubActionsIcon,
				badgeClassName: 'bg-[#06172f] text-[#2088FF]',
			},
			{
				name: 'Terraform',
				icon: TerraformIcon,
				badgeClassName: 'bg-white text-[#5c4ee5]',
			},
			{
				name: 'AWS',
				icon: AwsIcon,
				badgeClassName: 'bg-white text-[#252f3e]',
			},
			{
				name: 'GCP',
				icon: GcpIcon,
				badgeClassName: 'bg-white text-[#4285F4]',
			},
			{
				name: 'Railway',
				icon: RailwayIcon,
				badgeClassName: 'bg-[#0b1020] text-white',
			},
		],
	},
	{
		title: 'Arquitectura & Patrones',
		items: [
			{
				name: 'APIs RESTful',
				icon: PatternIcon,
				iconProps: { variant: 'rest' },
				badgeClassName: CONCEPT_PURPLE,
			},
			{
				name: 'SOLID',
				icon: PatternIcon,
				iconProps: { variant: 'solid' },
				badgeClassName: CONCEPT_BLUE,
			},
			{
				name: 'MVC / MVT',
				icon: PatternIcon,
				iconProps: { variant: 'mvc' },
				badgeClassName: CONCEPT_PURPLE,
			},
			{
				name: 'Webhooks',
				icon: PatternIcon,
				iconProps: { variant: 'webhook' },
				badgeClassName: CONCEPT_BLUE,
			},
			{
				name: 'Servicios SOAP',
				icon: PatternIcon,
				iconProps: { variant: 'soap' },
				badgeClassName: CONCEPT_PURPLE,
			},
			{
				name: 'Infraestructura como código',
				icon: PatternIcon,
				iconProps: { variant: 'iac' },
				badgeClassName: CONCEPT_BLUE,
