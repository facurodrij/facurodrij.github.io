---
interface Props {
	id: string;
	title: string;
	eyebrow?: string;
}

const { id, title, eyebrow = 'Detalle del proyecto' } = Astro.props;
const titleId = `${id}-title`;
---

<dialog
	id={id}
	class="project-dialog"
	aria-labelledby={titleId}
	data-project-dialog
>
	<div class="project-dialog__panel">
		<header class="project-dialog__header">
			<div>
				<p class="project-dialog__eyebrow">{eyebrow}</p>
				<h2 id={titleId} data-ui-heading="true" class="project-dialog__title">
					{title}
				</h2>
			</div>
			<button
				type="button"
				class="project-dialog__close ds-button ds-button-secondary ds-glass-button"
				aria-label="Cerrar"
				data-project-dialog-close
			>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M6 6l12 12M18 6L6 18"></path>
				</svg>
			</button>
		</header>

		<div class="project-dialog__body">
			<slot />
		</div>
	</div>
</dialog>

<script>
	const setupProjectDialogs = () => {
		document
			.querySelectorAll<HTMLButtonElement>('[data-project-dialog-open]')
			.forEach((trigger) => {
				if (trigger.dataset.dialogReady === 'true') return;
				trigger.dataset.dialogReady = 'true';

				trigger.addEventListener('click', () => {
					const dialog = document.getElementById(
						trigger.dataset.projectDialogOpen ?? '',
					);
					if (!(dialog instanceof HTMLDialogElement)) return;
					dialog.showModal();
					// Always start at the top, even if it was scrolled last time it was open.
					// Must run after showModal: a closed dialog isn't rendered and can't scroll.
					dialog.querySelector('.project-dialog__body')?.scrollTo(0, 0);
				});
			});

		document
			.querySelectorAll<HTMLDialogElement>('[data-project-dialog]')
			.forEach((dialog) => {
				if (dialog.dataset.dialogReady === 'true') return;
				dialog.dataset.dialogReady = 'true';

				dialog
					.querySelector('[data-project-dialog-close]')
					?.addEventListener('click', () => dialog.close());

				// A click on the dialog element itself (not its panel) is a backdrop click.
				dialog.addEventListener('click', (event) => {
					if (event.target === dialog) dialog.close();
				});
			});
	};

	document.addEventListener('astro:page-load', setupProjectDialogs);
</script>

<style>
	.project-dialog {
		width: min(68rem, calc(100vw - 2rem));
		max-width: none;
		max-height: calc(100dvh - 2rem);
		margin: auto;
		padding: 0;
		border: 1px solid rgba(148, 163, 184, 0.18);
		border-radius: var(--radius-lg);
		background: linear-gradient(180deg, #0b1324, #070d1a);
		color: var(--color-text);
		box-shadow: 0 40px 120px rgba(2, 6, 23, 0.7);
		overflow: hidden;
	}

	.project-dialog::backdrop {
		background: rgba(2, 6, 23, 0.72);
		backdrop-filter: blur(6px);
	}

	.project-dialog[open] {
		display: flex;
		animation: project-dialog-in 220ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.project-dialog[open]::backdrop {
		animation: project-dialog-fade 220ms ease;
	}

	:global(html:has(.project-dialog[open])) {
		overflow: hidden;
	}

	.project-dialog__panel {
		display: flex;
		flex-direction: column;
		width: 100%;
		max-height: calc(100dvh - 2rem);
	}

	.project-dialog__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem clamp(1rem, 3vw, 2rem);
		border-bottom: 1px solid var(--color-border);
		background: rgba(11, 19, 36, 0.92);
	}

	.project-dialog__eyebrow {
		font-family: var(--font-heading);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-primary);
	}

	.project-dialog__title {
		margin-top: 0.15rem;
		font-family: var(--font-heading);
		font-size: clamp(1.35rem, 3vw, 1.75rem);
		font-weight: 700;
		color: var(--color-heading);
	}

	.project-dialog__close {
		flex: none;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border-radius: 999px;
	}

	.project-dialog__close svg {
		width: 1.2rem;
		height: 1.2rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
	}

	.project-dialog__body {
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: clamp(1.25rem, 3vw, 2rem) clamp(1rem, 3vw, 2rem)
			clamp(1.5rem, 4vw, 2.5rem);
	}

	@media (max-width: 640px) {
		.project-dialog,
		.project-dialog__panel {
			width: 100vw;
			max-height: 100dvh;
			height: 100dvh;
		}

		.project-dialog {
			border: 0;
			border-radius: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-dialog[open],
		.project-dialog[open]::backdrop {
			animation: none;
		}
	}

	@keyframes project-dialog-in {
		from {
			opacity: 0;
			transform: translateY(12px) scale(0.98);
		}
	}

	@keyframes project-dialog-fade {
		from {
			opacity: 0;
		}
	}
</style>
