---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const {
	title,
	description = 'Facundo Joel Rodriguez, desarrollador Full Stack en Misiones, Argentina. Construyo backends y aplicaciones web con Python y Node.js, y me ocupo de que lleguen a producción.',
	image = '/og.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="author" content="Facundo Joel Rodriguez" />
		<meta name="theme-color" content="#020617" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Facundo Rodriguez" />
		<meta property="og:locale" content="es_AR" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />

		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'Person',
				name: 'Facundo Joel Rodriguez',
				jobTitle: 'Full Stack Developer',
				url: Astro.site?.href,
				image: new URL('/og.jpg', Astro.site).href,
				address: {
					'@type': 'PostalAddress',
					addressLocality: 'Posadas',
					addressRegion: 'Misiones',
					addressCountry: 'AR',
				},
				alumniOf: 'Universidad Nacional de Misiones',
				sameAs: [
					'https://github.com/facurodrij',
					'https://www.linkedin.com/in/facundo-joel-rodriguez/',
				],
			})}
		/>
		<ClientRouter />
	</head>
	<body class="ds-shell">
		<Header />

		<slot />

		<Footer />

		<script is:inline>
			(() => {
				const setupBackgroundSpotlight = () => {
					window.__backgroundSpotlightCleanup?.();

					const body = document.body;
					const root = document.documentElement;
					if (!body) return;

					const supportsFinePointer =
						window.matchMedia('(pointer: fine)').matches;
					const prefersReducedMotion = window.matchMedia(
						'(prefers-reduced-motion: reduce)',
					).matches;

					if (!supportsFinePointer || prefersReducedMotion) {
						body.dataset.pointerFine = 'false';
						body.dataset.spotlightActive = 'false';
						body.style.removeProperty('--mouse-x');
						body.style.removeProperty('--mouse-y');
						body.style.removeProperty('--background-spotlight-opacity');
						window.__backgroundSpotlightCleanup = undefined;
						return;
					}

					body.dataset.pointerFine = 'true';
					body.dataset.spotlightActive = 'false';

					let frameId = 0;
					let nextX = 0;
					let nextY = 0;

					const updateSpotlightOpacity = (x) => {
						const viewportWidth = window.innerWidth || 1;
						const normalizedX = Math.min(Math.max(x / viewportWidth, 0), 1);
						const centeredWeight = 1 - Math.abs(normalizedX - 0.5) * 2;
						const easedWeight =
							centeredWeight * centeredWeight * (3 - 2 * centeredWeight);
						const minOpacity = 0.32;
						const maxOpacity = 0.9;
						const spotlightOpacity =
							minOpacity + (maxOpacity - minOpacity) * easedWeight;

						body.style.setProperty(
							'--background-spotlight-opacity',
							spotlightOpacity.toFixed(3),
						);
					};

					const commitPosition = () => {
						frameId = 0;
						body.style.setProperty('--mouse-x', `${nextX}px`);
						body.style.setProperty('--mouse-y', `${nextY}px`);
						updateSpotlightOpacity(nextX);
					};

					const queuePosition = (event) => {
						nextX = event.clientX;
						nextY = event.clientY;
						body.dataset.spotlightActive = 'true';

						if (frameId) return;
						frameId = window.requestAnimationFrame(commitPosition);
					};

					const deactivate = () => {
						body.dataset.spotlightActive = 'false';
					};

					window.addEventListener('pointermove', queuePosition, {
						passive: true,
					});
					root.addEventListener('mouseleave', deactivate);
					window.addEventListener('pointercancel', deactivate);
					window.addEventListener('blur', deactivate);

					window.__backgroundSpotlightCleanup = () => {
						window.removeEventListener('pointermove', queuePosition);
						root.removeEventListener('mouseleave', deactivate);
						window.removeEventListener('pointercancel', deactivate);
						window.removeEventListener('blur', deactivate);

						if (frameId) {
							window.cancelAnimationFrame(frameId);
						}

						body.style.removeProperty('--mouse-x');
						body.style.removeProperty('--mouse-y');
						body.style.removeProperty('--background-spotlight-opacity');
					};
				};

				if (document.readyState === 'loading') {
					document.addEventListener(
						'DOMContentLoaded',
						setupBackgroundSpotlight,
						{
							once: true,
						},
					);
				} else {
					setupBackgroundSpotlight();
				}

				document.addEventListener('astro:page-load', setupBackgroundSpotlight);
			})();
		</script>
	</body>
</html>
